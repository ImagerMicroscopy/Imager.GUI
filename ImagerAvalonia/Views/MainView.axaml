<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ImagerAvalonia.ViewModels"
			 xmlns:model="using:ImagerAvalonia.Services.MeasurementControl"
             xmlns:views="clr-namespace:ImagerAvalonia.Views"
             mc:Ignorable="d"
             d:DesignWidth="1800"
             d:DesignHeight="1050"
             x:Class="ImagerAvalonia.Views.MainView"
             x:DataType="vm:MainViewModel">

	<Design.DataContext>
		<vm:MainViewModel />
	</Design.DataContext>



	<UserControl.Styles>




		<Style Selector="TabControl WrapPanel">
			<Setter Property="MaxHeight" Value="200" />
			<Setter Property="Margin" Value="2,0,0,0" />
		</Style>



		<Style Selector="TabItem">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="MinHeight" Value="12" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="0" />
			<Setter Property="Padding" Value="10 0" />
			<Setter Property="BorderThickness" Value="0.5 1 1 1" />
			<Setter Property="BorderBrush" Value="Black" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>

		<Style Selector="TabItem:selected">
			<Setter Property="Background" Value="#454545" />
			<Setter Property="Margin" Value="0" />
			<Setter Property="Padding" Value="10 0" />
		</Style>

		<Style Selector="TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#454545" />
		</Style>
	</UserControl.Styles>
	
	

	<DockPanel>
	<Menu DockPanel.Dock="Top">
		<MenuItem Header="_Imager">
		<Separator/>
		<MenuItem Header="_Exit" Click="OnExitRequested"/>
		</MenuItem>
		<MenuItem Header="_Data splitter">
		<MenuItem Header="Split current file" Click="OnSplittingRequested"/>
		</MenuItem>
	</Menu> 


	<SplitView IsPaneOpen="True"
			   DisplayMode="Inline"
			   OpenPaneLength="300"
			   PanePlacement="Left"
			   PaneBackground="Transparent">

		<SplitView.Pane>
			<Border BorderBrush="Gray" BorderThickness="0,0,0,0" Padding="0" Margin="0">

				<Grid Margin="10">
					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<!-- Experiments -->
						<Border x:Name="ExperimentsPanel" Background="#454545" BorderBrush="Black" BorderThickness="2" CornerRadius="5" BoxShadow="2 2 5 2 Black">
							<Expander IsExpanded="True" MinHeight="15" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0,4" Background="#454545"  >
								<Expander.Resources>
									<LinearGradientBrush x:Key="ExpanderHeaderBackground" StartPoint="0%,0%" EndPoint="100%,0%">
											<GradientStop Color="#ba96e3" Offset="0.0"/>
											<GradientStop Color="#ad76ea" Offset="1.0"/>
									</LinearGradientBrush>

									<LinearGradientBrush x:Key="ExpanderHeaderBackgroundPointerOver" StartPoint="0%,0%" EndPoint="100%,0%">
										<GradientStop Color="#bd86fa" Offset="0.0"/>
										<GradientStop Color="#6173a5" Offset="1.0"/>
									</LinearGradientBrush>

									<LinearGradientBrush x:Key="ExpanderHeaderBackgroundPressed" StartPoint="0%,0%" EndPoint="100%,0%">
										<GradientStop Color="#8d56ca" Offset="0.0"/>
										<GradientStop Color="#415385" Offset="1.0"/>
									</LinearGradientBrush>

								</Expander.Resources>
								<Expander.Header>
									<Grid Margin="0">
										<TextBlock Padding="0"
													Margin="0 5 16 0"
													VerticalAlignment="Center"
													Height="27"
													FontSize="17"
													Width="200"
													Background="Transparent"
													Text="Experiments"/>
									</Grid>								
								</Expander.Header>
								<!-- The output location settings are pinned below the scroller so
						     they stay put when the selected element's settings change height. -->
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="*" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
						<ScrollViewer Grid.Row="0" x:Name="ExperimentsScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
							<StackPanel IsEnabled="{Binding IsEnableExperimentalPanel}" Width="270">
								<Border
									CornerRadius="5"
									BorderBrush="Transparent"
									BorderThickness="0.5"
									ClipToBounds="True">
								<ListBox 
									        CornerRadius="5 5 5 5" 
											BorderBrush="Black" BorderThickness="1"
											Background="Gray"
											x:Name="AvailableExperiments"
											ItemsSource="{Binding Experiments}"
											SelectedItem="{Binding SelectedExperiment}"
											Height="100"
											Width="266"
											ClipToBounds="True">
									<ListBox.ItemTemplate>
										<DataTemplate>
											<TextBlock Margin="5 0 0 0" VerticalAlignment="Center"  Text="{Binding ExperimentName}" />
										</DataTemplate>
									</ListBox.ItemTemplate>
									<ListBox.Styles>
										<Style Selector="ListBoxItem">
											<Setter Property="Background" Value="Transparent"/>
											<Setter Property="Height" Value="25"/>
											<Setter Property="FontSize" Value="12"/>
											<Setter Property="Padding" Value="0"/>
											<Setter Property="Foreground" Value="White"/>
										</Style>
										<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
											<Setter Property="Background">
												<Setter.Value>
													<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
														<GradientStop Color="#ba96e3" Offset="0.0"/>
														<GradientStop Color="#ad76ea" Offset="1.0"/>
													</LinearGradientBrush>
												</Setter.Value>
											</Setter>
											<Setter Property="Height" Value="25"/>
											<Setter Property="FontSize" Value="12"/>
											<Setter Property="Padding" Value="0"/>
											<Setter Property="CornerRadius" Value="5"/>
										</Style>
										
									</ListBox.Styles>

								</ListBox>
								</Border>
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="14.8" Margin="2 0 0 0">
										<Button Height="25" Padding="0 3 0 3" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Width="55" BorderBrush="#2e2e2e" Command="{Binding AddExperiment}">
											Add
										</Button>					
										<Button  Height="25"  Padding="0 3 0 3"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Width="55" BorderBrush="#2e2e2e" Command="{Binding SaveExperiment}">
											Save
										</Button>
										<Button  Height="25"  Padding="0 3 0 3"  VerticalContentAlignment="Center"  HorizontalContentAlignment="Center" Width="55" BorderBrush="#2e2e2e" Command="{Binding LoadExperiment}">
											Load
										</Button>
										<Button  Height="25"  Padding="0 3 0 3"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Width="55" BorderBrush="#2e2e2e" Command="{Binding RemoveExperiment}">
											Remove
										</Button>
								</StackPanel>
								<Border  Margin="0 5 2 0" BorderThickness="0 1 0 0" Width="250" BorderBrush="Gray">
									
								</Border>
								<views:ExperimentalPanelViewControl Margin="0 5 0 0"  Padding="0" HorizontalAlignment="Left" Width="270"  x:Name="ExperimentalPanelViewControl"
											 DataContext="{Binding SelectedExperiment}"/>
							</StackPanel>
							</ScrollViewer>
							<Border Grid.Row="1" Margin="6 5 6 5"
												 IsEnabled="{Binding IsEnableExperimentalPanel}">
								<views:RootPanelView DataContext="{Binding SelectedExperiment.Root}"/>
							</Border>
						</Grid>
							</Expander>


						</Border>
				</Grid>
			</Border>
		</SplitView.Pane>

		<SplitView.Content>

			<SplitView IsPaneOpen="True"
			   DisplayMode="Inline"
			   OpenPaneLength="297"
			   PanePlacement="Right"
		   PaneBackground="Transparent">

				<SplitView.Content>
					
			
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*"/>
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="0"/>
						</Grid.ColumnDefinitions>

						<views:ImageControlPanelView x:Name="ImageControlView"
													 DataContext="{Binding ImageControlPanel}"
													 Grid.RowSpan="2"
													 Grid.Column="0"/>
					</Grid>
			
			
				</SplitView.Content>
				<SplitView.Pane>
					<ScrollViewer>
						<Border BorderBrush="Gray" BorderThickness="0,0,0,0" Padding="0" Margin="0">
							<StackPanel Width="280"  Margin="0 10 0 0">

										<views:AcquisitionsPanelView />

									<Border  Margin="0 10 0 0" Background="#454545" BorderBrush="Black" BorderThickness="2" CornerRadius="5" BoxShadow="2 2 5 2 Black">
											<Expander IsExpanded="False" MinHeight="15" VerticalAlignment="Top" Background="#454545"  >
												<Expander.Resources>
													<LinearGradientBrush x:Key="ExpanderHeaderBackground" StartPoint="0%,0%" EndPoint="100%,0%">
															<GradientStop Color="#ba96e3" Offset="0.0"/>
															<GradientStop Color="#ad76ea" Offset="1.0"/>
													</LinearGradientBrush>
													<LinearGradientBrush x:Key="ExpanderHeaderBackgroundPointerOver" StartPoint="0%,0%" EndPoint="100%,0%">
														<GradientStop Color="#bd86fa" Offset="0.0"/>
														<GradientStop Color="#6173a5" Offset="1.0"/>
													</LinearGradientBrush>
													<LinearGradientBrush x:Key="ExpanderHeaderBackgroundPressed" StartPoint="0%,0%" EndPoint="100%,0%">
														<GradientStop Color="#8d56ca" Offset="0.0"/>
														<GradientStop Color="#415385" Offset="1.0"/>
													</LinearGradientBrush>
												</Expander.Resources>
												<Expander.Header>
													<Grid Margin="0">
															<TextBlock Padding="0"
																		Margin="0 5 16 0"
																		VerticalAlignment="Center"
																		Height="27"
																		FontSize="17"
																		Width="200"
																		Background="Transparent"
																		Text="Stage control"/>
													</Grid>										
												</Expander.Header>
												<StackPanel Width="250">
													<views:StageControlPanelView x:Name="StageControlPanelViewControl"/>
												</StackPanel>
											</Expander>
										</Border>

								

									<Border  Margin="0 10 0 0" Background="#454545" BorderBrush="Black" BorderThickness="2" CornerRadius="5" BoxShadow="2 2 5 2 Black">
										<Expander IsExpanded="True" MinHeight="15" VerticalAlignment="Top" Background="#454545"  >
											<Expander.Resources>
												<LinearGradientBrush x:Key="ExpanderHeaderBackground" StartPoint="0%,0%" EndPoint="100%,0%">
														<GradientStop Color="#ba96e3" Offset="0.0"/>
														<GradientStop Color="#ad76ea" Offset="1.0"/>
												</LinearGradientBrush>

												<LinearGradientBrush x:Key="ExpanderHeaderBackgroundPointerOver" StartPoint="0%,0%" EndPoint="100%,0%">
													<GradientStop Color="#bd86fa" Offset="0.0"/>
													<GradientStop Color="#6173a5" Offset="1.0"/>
												</LinearGradientBrush>

												<LinearGradientBrush x:Key="ExpanderHeaderBackgroundPressed" StartPoint="0%,0%" EndPoint="100%,0%">
													<GradientStop Color="#8d56ca" Offset="0.0"/>
													<GradientStop Color="#415385" Offset="1.0"/>
												</LinearGradientBrush>

											</Expander.Resources>
											<Expander.Header>
													<Grid Margin="0">
															<TextBlock Padding="0"
																		Margin="0 5 16 0"
																		VerticalAlignment="Center"
																		Height="27"
																		FontSize="17"
																		Width="200"
																		Background="Transparent"
																		Text="Status messages"/>
													</Grid>							
											</Expander.Header>
											<StackPanel Width="250">


												<views:StatusWindowView  x:Name="StatusViewControl" Height="100"/>

											</StackPanel>

										</Expander>


									</Border>
							</StackPanel>
							
						</Border>
					</ScrollViewer>
				</SplitView.Pane>
			</SplitView>
		</SplitView.Content>

	</SplitView>
	</DockPanel>
</UserControl>
