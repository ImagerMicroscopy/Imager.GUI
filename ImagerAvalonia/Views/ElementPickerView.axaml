<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ImagerAvalonia.ViewModels"
             xmlns:measurement_elem="clr-namespace:ImagerAvalonia.Services.MeasurementControl"
             mc:Ignorable="d"
             x:Class="ImagerAvalonia.Views.ElementPickerView"
             x:DataType="vm:MeasurementElementViewModel"
             x:Name="Picker">

	<!-- Shared element picker shown by the "+" action on the tree view cards.
	     The DataContext is the node the element will be added inside. -->
	<UserControl.Styles>
		<Style Selector="TextBlock.flyGroupHeader">
			<Setter Property="FontSize" Value="10" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Margin" Value="1 0 0 2" />
		</Style>
		<Style Selector="TextBlock.flyGroupHeader.loopsHeader">
			<Setter Property="Foreground" Value="#b79ae8" />
		</Style>
		<Style Selector="TextBlock.flyGroupHeader.stepsHeader">
			<Setter Property="Foreground" Value="#a8a8a8" />
		</Style>
		<Style Selector="Button.elementChip">
			<Setter Property="FontSize" Value="9" />
			<Setter Property="MinHeight" Value="22" />
			<Setter Property="Padding" Value="1 0" />
			<Setter Property="Margin" Value="1" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>
		<Style Selector="Button.elementChip.loopChip">
			<Setter Property="Background" Value="#4a3d68" />
			<Setter Property="BorderBrush" Value="#8a5bd0" />
		</Style>
		<Style Selector="Button.elementChip.loopChip:pointerover">
			<Setter Property="Background" Value="#5d4a87" />
		</Style>
		<Style Selector="Button.elementChip.stepChip">
			<Setter Property="Background" Value="#333333" />
			<Setter Property="BorderBrush" Value="#565656" />
		</Style>
		<Style Selector="Button.elementChip.stepChip:pointerover">
			<Setter Property="Background" Value="#444444" />
		</Style>
	</UserControl.Styles>

	<Border Width="190" Background="#333333" CornerRadius="5" Padding="6" BorderBrush="#6a4fae" BorderThickness="1">
		<StackPanel>
			<TextBlock Classes="flyGroupHeader loopsHeader" Text="Loops — contain other elements"/>
			<UniformGrid Columns="2">
				<Button Classes="elementChip loopChip" Content="Do N times" Command="{Binding AddChildElementCommand}" CommandParameter="{x:Static measurement_elem:ExperimentElementType.DoTimes}" ToolTip.Tip="Run the contained elements N times in a row."/>
				<Button Classes="elementChip loopChip" Content="Time lapse" Command="{Binding AddChildElementCommand}" CommandParameter="{x:Static measurement_elem:ExperimentElementType.TimeLapse}" ToolTip.Tip="Repeat the contained elements at a fixed time interval."/>
				<Button Classes="elementChip loopChip" Content="Stage loop" Command="{Binding AddChildElementCommand}" CommandParameter="{x:Static measurement_elem:ExperimentElementType.StageLoop}" IsEnabled="{Binding AreStagesAvailable}" ToolTip.Tip="Run the contained elements at each saved stage position. Requires a motorized stage."/>
				<Button Classes="elementChip loopChip" Content="Rel. stage loop" Command="{Binding AddChildElementCommand}" CommandParameter="{x:Static measurement_elem:ExperimentElementType.RelativeStageLoop}" IsEnabled="{Binding AreStagesAvailable}" ToolTip.Tip="Run the contained elements on a grid around the current stage position. Requires a motorized stage."/>
			</UniformGrid>
			<TextBlock Classes="flyGroupHeader stepsHeader" Text="Steps — run once, in order"/>
			<UniformGrid Columns="2">
				<Button Classes="elementChip stepChip" Content="Acquire" Command="{Binding AddChildElementCommand}" CommandParameter="{x:Static measurement_elem:ExperimentElementType.Detection}" ToolTip.Tip="Acquire an image with the enabled detectors."/>
				<Button Classes="elementChip stepChip" Content="Wait" Command="{Binding AddChildElementCommand}" CommandParameter="{x:Static measurement_elem:ExperimentElementType.WaitForTime}" ToolTip.Tip="Pause for a set duration."/>
				<Button Classes="elementChip stepChip" Content="Illuminate" Command="{Binding AddChildElementCommand}" CommandParameter="{x:Static measurement_elem:ExperimentElementType.Irradiation}" IsEnabled="{Binding AreSourcesAvailable}" ToolTip.Tip="Apply light for a set duration."/>
				<Button Classes="elementChip stepChip" Content="Switch acq." Command="{Binding AddChildElementCommand}" CommandParameter="{x:Static measurement_elem:ExperimentElementType.UpdateAcquisition}" ToolTip.Tip="Change detector/acquisition settings mid-program."/>
				<Button Classes="elementChip stepChip" Content="Robot" Command="{Binding AddChildElementCommand}" CommandParameter="{x:Static measurement_elem:ExperimentElementType.Robot}" ToolTip.Tip="Run a hardware program (if available)."/>
			</UniformGrid>
			<TextBlock FontSize="9" FontStyle="Italic" Foreground="Gray" Margin="1 3 0 0" Text="{Binding #Picker.FooterText}"/>
		</StackPanel>
	</Border>
</UserControl>
