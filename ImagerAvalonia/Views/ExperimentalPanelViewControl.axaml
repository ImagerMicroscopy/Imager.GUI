<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			
             mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="450"
			 xmlns:vm="clr-namespace:ImagerAvalonia.ViewModels"
			 xmlns:views="clr-namespace:ImagerAvalonia.Views"
			 xmlns:service_vm="clr-namespace:ImagerAvalonia.Services"
			 xmlns:measurement_elem="clr-namespace:ImagerAvalonia.Services.MeasurementControl"
             x:Class="ImagerAvalonia.Views.ExperimentalPanelViewControl"
			 x:DataType="vm:ExperimentalPanelViewModel"
			 xmlns:reactive="using:System.Reactive"
			 Width="280"
			 Background="#454545">



	<UserControl.Styles>

		<Style Selector="TreeViewItem">
			<Setter Property="Template">
				<ControlTemplate>
					<Border Background="{TemplateBinding Background}">
						<StackPanel>
							<StackPanel Orientation="Horizontal">
								<!-- Custom Chevron -->
	
								<ContentPresenter
									Content="{TemplateBinding Header}"
									VerticalAlignment="Center"/>
							</StackPanel>

							<ItemsPresenter
								Margin="16,0,0,0"
								IsVisible="{TemplateBinding IsExpanded}"/>
						</StackPanel>
					</Border>
				</ControlTemplate>
			</Setter>
		</Style>
		<!-- Tree node action mock-up styles -->
		<Style Selector="Button.nodeActionBtn">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Width" Value="22" />
			<Setter Property="Height" Value="22" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Margin" Value="1 0 0 0" />
			<Setter Property="CornerRadius" Value="3" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		<Style Selector="Button.nodeActionBtn:pointerover">
			<Setter Property="Background" Value="#5d4a87" />
		</Style>
		<Style Selector="StackPanel.nodeActions">
			<Setter Property="Opacity" Value="0" />
		</Style>
		<Style Selector="Border.node:pointerover StackPanel.nodeActions">
			<Setter Property="Opacity" Value="1" />
		</Style>
		<Style Selector="Border.treeDivider:pointerover Rectangle">
			<Setter Property="Fill" Value="#8a5bd0" />
		</Style>
	</UserControl.Styles>


	<Grid>

		<Grid.RowDefinitions>

			<RowDefinition Height="Auto" />
			<RowDefinition Height="400" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />

		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0" FontSize="10" FontStyle="Italic" Foreground="Gray" Margin="2 2 2 2" Text="Hover an element to add or delete it; + adds an element inside that node"/>
			<TreeView Grid.Row="1" Margin="2 2 2 0" x:Name="ExperimentTreeView" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedTreeItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
			<TreeView.Resources>
				<x:Double x:Key="TreeViewItemExpandCollapseChevronSize">24</x:Double>
			</TreeView.Resources>


			<TreeView.Styles>

				<!-- Default border for every node card -->
				<Style Selector="Border.node">
					<Setter Property="BorderThickness" Value="2" />
					<Setter Property="BorderBrush" Value="#2e2e2e" />
				</Style>

				<!-- Hover feedback -->
				<Style Selector="Border.node:pointerover">
					<Setter Property="BorderBrush" Value="#8a5bd0" />
				</Style>

				<!-- The selected node card follows the tree view's real selection state,
				     so programmatic selection updates highlight the right card too. -->
				<Style Selector="TreeViewItem:selected Border.node">
					<Setter Property="BorderBrush" Value="#ad76ea" />
				</Style>
				<Style Selector="TreeViewItem">
					<Setter Property="MinHeight" Value="18"/>
					<!--  PointerOver state  -->
					<Style Selector="^ /template/ Border#PART_LayoutRoot:pointerover">
						<Setter Property="Background" Value="Transparent" />
						<Setter Property="BorderBrush" Value="Transparent" />
					</Style>

					<!--  Pressed state  -->
					<Style Selector="^:pressed /template/ Border#PART_LayoutRoot:pointerover">
						<Setter Property="Background" Value="Transparent" />
						<Setter Property="BorderBrush" Value="Transparent" />
					</Style>

					<!--  Disabled state  -->
					<Style Selector="^:disabled /template/ Border#PART_LayoutRoot">
						<Setter Property="Background" Value="Transparent" />
						<Setter Property="BorderBrush" Value="Transparent" />
					</Style>

					<!--  Selected state  -->
					<Style Selector="^:selected /template/ Border#PART_LayoutRoot">
						<Setter Property="Background" Value="Transparent" />
						<Setter Property="BorderBrush" Value="Transparent" />
					</Style>

		


					<!--  Selected PointerOver state  -->
					<Style Selector="^:selected /template/ Border#PART_LayoutRoot:pointerover">
						<Setter Property="Background" Value="Transparent" />
						<Setter Property="BorderBrush" Value="Transparent" />
					</Style>

					<!--  Selected Pressed state  -->
					<Style Selector="^:pressed:selected /template/ Border#PART_LayoutRoot:pointerover">
						<Setter Property="Background" Value="Transparent" />
						<Setter Property="BorderBrush" Value="Transparent" />
					</Style>





					<!--  Disabled Selected state  -->
					<Style Selector="^:disabled:selected /template/ Border#PART_LayoutRoot">
						<Setter Property="Background" Value="Transparent" />
						<Setter Property="BorderBrush" Value="Transparent" />
					</Style>

				</Style>

				<!-- Default border for every node card -->
				<Style Selector="Border.node">
					<Setter Property="BorderThickness" Value="2" />
					<Setter Property="BorderBrush" Value="#2e2e2e" />
				</Style>

				<!-- Hover feedback -->
				<Style Selector="Border.node:pointerover">
					<Setter Property="BorderBrush" Value="#8a5bd0" />
				</Style>

			</TreeView.Styles>
			<TreeView.ItemContainerTheme>
				<ControlTheme TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
					<Setter Property="IsExpanded" Value="True" />
					<Setter Property="IsVisible" Value="True" />

				</ControlTheme>
			</TreeView.ItemContainerTheme>


			<TreeView.DataTemplates>
				<TreeDataTemplate DataType="vm:MeasurementElementViewModel" ItemsSource="{Binding Children}">
					<Grid ClipToBounds="False" Height="34">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Border x:Name="InsertBeforeLine" Grid.Row="0" Height="3" Background="#ad76ea" Opacity="0" IsHitTestVisible="False" CornerRadius="2" />
						<Border Classes="node" Grid.Row="1"
								ClipToBounds="False"
								DragDrop.AllowDrop="True"
								PointerPressed="OnNodePointerPressed"
								PointerMoved="OnNodePointerMoved"
								DragDrop.DragOver="OnNodeDragOver"
								DragDrop.DragLeave="OnNodeDragLeave"
								DragDrop.Drop="OnNodeDrop"
								DoubleTapped="OnElementDoubleTapped"
								Cursor="Hand"
								HorizontalAlignment="Left"
								Height="28"
								CornerRadius="3"
								Width="210"
								Background="Gray">
							<Grid ColumnDefinitions="*,Auto">
								<StackPanel Grid.Column="0" Orientation="Horizontal">
									<ItemsControl ItemsSource="{Binding SmartProgramBindings}">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<StackPanel Orientation="Horizontal" />
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate DataType="service_vm:SmartProgramInput">
												<Rectangle Width="6" Margin="0 0 1 0" Fill="{Binding SmartProgramColor}" />
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
									<StackPanel Width="150" Orientation="Horizontal">
										<TextBlock Foreground="White" Margin="3 0 0 0" VerticalAlignment="Center" FontSize="12" Text="{Binding Header}" />
										<TextBlock Margin="5 0 0 0" TextTrimming="CharacterEllipsis" Width="70" VerticalAlignment="Center" Foreground="White" FontSize="12" Text="{Binding DisplayedInfo, Mode=TwoWay}" />
									</StackPanel>
								</StackPanel>
								<StackPanel Grid.Column="1" Classes="nodeActions" Orientation="Horizontal" VerticalAlignment="Center">
									<Button Classes="nodeActionBtn" Content="+" IsVisible="{Binding CanHaveChildren}" ToolTip.Tip="Add an element inside this one">
										<Button.Flyout>
											<Flyout Placement="Right">
												<views:ElementPickerView FooterText="Adds inside this element"/>
											</Flyout>
										</Button.Flyout>
									</Button>
									<Button Classes="nodeActionBtn" Content="×" Command="{Binding DeleteElementCommand}" ToolTip.Tip="Delete this element"/>
								</StackPanel>
							</Grid>
						</Border>
						<Border x:Name="InsertAfterLine" Grid.Row="2" Height="3" Background="#ad76ea" Opacity="0" IsHitTestVisible="False" CornerRadius="2" />
					</Grid>
				</TreeDataTemplate>
				<TreeDataTemplate DataType="vm:RootNode" ItemsSource="{Binding Children}">
					<Border Classes="node"
							ClipToBounds="False"
							DragDrop.AllowDrop="True"
							PointerPressed="OnNodePointerPressed"
							DragDrop.DragOver="OnNodeDragOver"
							DragDrop.DragLeave="OnNodeDragLeave"
							DragDrop.Drop="OnNodeDrop"
							HorizontalAlignment="Left"
							Height="30"
							CornerRadius="3"
							Width="120"
							Background="Gray">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock Grid.Column="0" Margin="3 0 0 0" VerticalAlignment="Center" FontSize="12" Foreground="White" Text="{Binding Header}" />
							<StackPanel Grid.Column="1" Classes="nodeActions" Orientation="Horizontal" VerticalAlignment="Center">
								<Button Classes="nodeActionBtn" Content="+" ToolTip.Tip="Add an element at the top level">
									<Button.Flyout>
										<Flyout Placement="Right">
											<views:ElementPickerView FooterText="Adds at the top level"/>
										</Flyout>
									</Button.Flyout>
								</Button>
							</StackPanel>
						</Grid>
					</Border>
				</TreeDataTemplate>
			</TreeView.DataTemplates>
		</TreeView>
		<!-- Draggable divider: resizing the tree row resizes the program tree view. -->
		<Border x:Name="TreeDivider" Grid.Row="2" Classes="treeDivider" Height="10" Margin="2 3 2 0"
				Background="Transparent" Cursor="SizeNorthSouth"
				PointerPressed="OnTreeDividerPointerPressed"
				PointerMoved="OnTreeDividerPointerMoved"
				PointerReleased="OnTreeDividerPointerReleased">
			<Rectangle Height="2" VerticalAlignment="Center" Fill="Gray" />
		</Border>
		<TransitioningContentControl
			Margin="4 0 0 0"
			Content="{Binding SelectedTreeItem}"
			Grid.Row="3">

			<TransitioningContentControl.DataTemplates>

				<DataTemplate DataType="vm:RootNode">
					<!-- The root element itself carries no editable settings; its
					     output location options live in the panel pinned at the
					     bottom of the Experiments pane. -->
					<TextBlock Margin="0 4 0 8" FontSize="10" FontStyle="Italic" Foreground="Gray"
							   Text="The root element cannot be modified; use + to add top-level elements." />
				</DataTemplate>

				<DataTemplate DataType="vm:DoTimesViewModel">
					<views:DoTimesView />
				</DataTemplate>

				<DataTemplate DataType="vm:RelStageViewModel">
					<views:RelStageView />
				</DataTemplate>

				<DataTemplate DataType="vm:TimeLapseViewModel">
					<views:TimeLapseView />
				</DataTemplate>

				<DataTemplate DataType="vm:StageLoopViewModel">
					<views:StageLoopView />
				</DataTemplate>

				<DataTemplate DataType="vm:WaitViewModel">
					<views:WaitView />
				</DataTemplate>

				<DataTemplate DataType="vm:DetectionElementViewModel">
					<views:AcquisitionPanelView />
				</DataTemplate>

				<DataTemplate DataType="vm:IrradiationPanelViewModel">
					<views:IrradiationPanelView />
				</DataTemplate>

				<DataTemplate DataType="vm:RobotControlViewModel">
					<views:RobotControlView />
				</DataTemplate>

				
				<DataTemplate DataType="vm:UpdateAcquisitionViewModel">
					<views:UpdateAcquisitionView />
				</DataTemplate>

			</TransitioningContentControl.DataTemplates>

		</TransitioningContentControl>
	</Grid>

</UserControl>