<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
			 Width="280"
             xmlns:vm="clr-namespace:ImagerAvalonia.ViewModels"
             x:Class="ImagerAvalonia.Views.RootPanelView"
			 x:DataType="vm:RootPanelViewModel">





	<UserControl.Styles >

		<Style Selector="Border.header-border">
			<Setter Property="Background">
				<Setter.Value>
					<SolidColorBrush Color="#454545"  />
				</Setter.Value>
			</Setter>
			<Setter Property="BorderBrush" Value="Black" />
			<Setter Property="BorderThickness" Value="0.5" />
			<Setter Property="MaxWidth" Value="900" />
			<Setter Property="Padding" Value="10" />
		</Style>

		<Style Selector="TextBlock.header">
			<Setter Property="FontSize" Value="18" />
			<Setter Property="FontWeight" Value="Bold" />
		</Style>

		<Style Selector="Border.thin">
			<Setter Property="BorderBrush" Value="Black" />
			<Setter Property="BorderThickness" Value="0.5" />
			<Setter Property="CornerRadius" Value="0,0,5,5" />
			<Setter Property="Margin" Value="0,0,0,15" />
		</Style>

	</UserControl.Styles>
	

	
	<StackPanel ClipToBounds="False" Orientation="Vertical"
				Width="600"
			    HorizontalAlignment="Left"
				Background="#454545"
				Margin="6 0 0 0">
		<StackPanel  Orientation="Vertical"
					Spacing="4">
			<TextBlock Margin="0 0 0 0" Text="Root" Classes="header" />
		</StackPanel>
		

			<Grid RowDefinitions="30,30,30" >
				



				<Grid  Grid.Row="0"  ColumnDefinitions="90,120,50">
				<TextBlock Grid.Column="0" Width="90" Margin="0,0,0,0"
										VerticalAlignment="Center"
										Text="Save directory"
										FontSize="12"
										TextTrimming="CharacterEllipsis" />
					
				<TextBox Margin="0 1 0 0" HorizontalAlignment="Left"  VerticalAlignment="Center"  Grid.Column="1" Height="23" MinHeight="10" Width="110" Watermark="Save path" IsReadOnly="True" Text="{Binding OutputFolder}">
				</TextBox>
				<Button VerticalAlignment="Center" Height="25" Width="53"  Grid.Column="2" Command="{Binding SelectOutputFolder}" HorizontalContentAlignment="Center"  BorderBrush="#2e2e2e"   Foreground="White">Open</Button>

				</Grid>

				<Grid  Grid.Row="1" ColumnDefinitions="90,170">
					<TextBlock Width="90"  VerticalAlignment="Center"   Grid.Column="0" Margin="0,0,0,0"
										 Text="Output name"
										 FontSize="12"
										 TextTrimming="CharacterEllipsis" />
					
					<TextBox VerticalAlignment="Center" HorizontalAlignment="Left"    Grid.Column="1" Height="23" MinHeight="10"  Width="174" Watermark="Output name"  Text="{Binding FileName}"/>


				</Grid>

				
				<Grid  Grid.Row="2" ColumnDefinitions="90,100,60">
					<TextBlock VerticalAlignment="Center"   Grid.Column="0" Margin="0,0,0,0"
										 Text="Save output?"
										 FontSize="12"
										 TextTrimming="CharacterEllipsis" />
					
					<CheckBox IsChecked="{Binding IsStorageEnabled}"  VerticalAlignment="Center"    Grid.Column="1"> </CheckBox>


				</Grid>
			</Grid>
			
			
	</StackPanel>
	
</UserControl>
