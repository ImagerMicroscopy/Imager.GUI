<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 
             xmlns:vm="clr-namespace:ImagerAvalonia.ViewModels"
             x:Class="ImagerAvalonia.Views.WaitView"
			 x:DataType="vm:WaitViewModel">





	<UserControl.Styles >

		<Style Selector="Border.header-border">
			<Setter Property="Background">
				<Setter.Value>
					<SolidColorBrush Color="#454545"  />
				</Setter.Value>
			</Setter>
			<Setter Property="BorderBrush" Value="Black" />
			<Setter Property="BorderThickness" Value="0.5" />
			<Setter Property="MaxWidth" Value="750" />
			<Setter Property="Padding" Value="10" />
		</Style>

		<Style Selector="TextBlock.header">
			<Setter Property="FontSize" Value="18" />
			<Setter Property="FontWeight" Value="Bold" />
		</Style>

		<Style Selector="Border.thin">
			<Setter Property="BorderBrush" Value="Black" />
			<Setter Property="BorderThickness" Value="0.5" />
			<Setter Property="CornerRadius" Value="0,0,5,5" />
			<Setter Property="Margin" Value="0,0,0,15" />
		</Style>

	</UserControl.Styles>



	<StackPanel Orientation="Vertical"
				Width="600"
			    HorizontalAlignment="Left"
				Background="#454545">
			<StackPanel Orientation="Vertical"
						Spacing="4">
				<TextBlock Text="Wait" Classes="header" />
			</StackPanel>


			<Grid ColumnDefinitions="50,100,9.5*" RowDefinitions="Auto,Auto"  Margin="4">
				<TextBlock VerticalAlignment="Center" Text="Wait for " FontSize="11"  Grid.Row="0" Grid.Column="0" Margin="6"/>
				<NumericUpDown Height="25" Classes="custom-numeric-style" Width="100" Value="{Binding WaitPeriod,Mode=TwoWay}" Minimum="0" IsTabStop="True"
				   ShowButtonSpinner="False"
								   HorizontalAlignment="Left" Grid.Row="0" Grid.Column="1" Margin="0"  />
				<TextBlock  VerticalAlignment="Center" FontSize="11" Text="seconds."  Grid.Row="0" Grid.Column="2" Margin="6" HorizontalAlignment="Left"/>			
			</Grid>


	</StackPanel>

</UserControl>

