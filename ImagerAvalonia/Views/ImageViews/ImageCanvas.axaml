<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="850"
             x:Class="ImagerAvalonia.Views.ImageCanvas"
             xmlns:vm="clr-namespace:ImagerAvalonia.ViewModels"
             x:DataType="vm:ImageCanvasViewModel">

	<UserControl.Styles>
		<Style Selector="ToggleButton#ContrastToggle">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="ToggleButton#ContrastToggle /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>
		<Style Selector="ToggleButton#ContrastToggle:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#555555"/>
		</Style>
		<Style Selector="ToggleButton#ContrastToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#606060"/>
		</Style>
		<Style Selector="ToggleButton#ContrastToggle Path">
			<Setter Property="Fill" Value="White"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style Selector="ToggleButton#ContrastToggle:checked Path, ToggleButton#ContrastToggle:pointerover Path">
			<Setter Property="Fill" Value="#ba96e3"/>
		</Style>
	</UserControl.Styles>

	<Border x:Name="TileBorder" BorderBrush="#2e2e2e" BorderThickness="1" ClipToBounds="True">
		<DockPanel>

			<Border DockPanel.Dock="Top" Background="#3a3a3a" Padding="8 3">
				<Grid ColumnDefinitions="Auto, *">
					<ToggleButton Grid.Column="0" x:Name="ContrastToggle" Width="22" Height="18" Padding="0"
					              HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0 0 6 0"
					              IsChecked="{Binding IsContrastPanelVisible}"
					              ToolTip.Tip="Show contrast settings and histogram for this image">
						<Panel>
							<Path Data="M 0 0 L 0 10 L 6 5 Z"
							      IsVisible="{Binding !$parent[ToggleButton].IsChecked}" />
							<Path Data="M 0 0 L 10 0 L 5 6 Z"
							      IsVisible="{Binding $parent[ToggleButton].IsChecked}" />
						</Panel>
					</ToggleButton>
					<TextBlock Grid.Column="1" Text="{Binding HeaderText}" FontSize="14" Foreground="White" />
				</Grid>
			</Border>

			<Grid x:Name="TileBody" Background="#454545" ClipToBounds="True">
				<Panel x:Name="WorldHost" Width="800" Height="800"
				       HorizontalAlignment="Left" VerticalAlignment="Top"
				       RenderTransformOrigin="0,0">
					<Canvas x:Name="DisplayedCanvas" Width="800" Height="800">
						<Image x:Name="DisplayedImage" Width="800" Height="800" Stretch="Uniform"
						       RenderOptions.BitmapInterpolationMode="None" />
					</Canvas>
				</Panel>

				<Border x:Name="ContrastOverlay" IsVisible="{Binding IsContrastPanelVisible}"
				        HorizontalAlignment="Left" VerticalAlignment="Top"
				        Margin="6 6 6 6" Width="274" Padding="8"
				        Background="#F02b2b2b" BorderBrush="#5f5f5f" BorderThickness="1"
				        CornerRadius="5" BoxShadow="0 4 12 2 #80000000">
					<ContentControl x:Name="ContrastPanelHost" />
				</Border>
			</Grid>

		</DockPanel>
	</Border>

</UserControl>
