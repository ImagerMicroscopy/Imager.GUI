<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ImagerAvalonia.ViewModels"
			 xmlns:views="clr-namespace:ImagerAvalonia.Views"

			 xmlns:ScottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             mc:Ignorable="d" d:DesignWidth="2200" d:DesignHeight="1850"
             x:Class="ImagerAvalonia.Views.ImageDisplayView"
             x:DataType="vm:ImageDisplayViewModel"
			 DragDrop.AllowDrop="True">

	<UserControl.Styles>
		<Style Selector="StackPanel#imageControls Button, StackPanel#imageControls ToggleButton">
			<Setter Property="Width" Value="32"/>
			<Setter Property="Height" Value="32"/>
			<Setter Property="Padding" Value="3"/>
			<Setter Property="Background" Value="Gainsboro"/>
			<Setter Property="BorderBrush" Value="#2b2b2b"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="6"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>
		<Style Selector="StackPanel#imageControls Button /template/ ContentPresenter#PART_ContentPresenter, StackPanel#imageControls ToggleButton /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="VerticalAlignment" Value="Stretch"/>
		</Style>
		<Style Selector="StackPanel#imageControls Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, StackPanel#imageControls ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#ba96e3"/>
			<Setter Property="BorderBrush" Value="#2b2b2b"/>
		</Style>
		<Style Selector="StackPanel#imageControls ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#ad76ea"/>
			<Setter Property="BorderBrush" Value="#2b2b2b"/>
		</Style>
		<Style Selector="ToggleButton.dock-toggle">
			<Setter Property="Height" Value="21"/>
			<Setter Property="Padding" Value="10 0"/>
			<Setter Property="Margin" Value="4 0 0 0"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Background" Value="#5a5a5a"/>
			<Setter Property="BorderBrush" Value="#2e2e2e"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
		<Style Selector="ToggleButton.dock-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#6a6a6a"/>
			<Setter Property="BorderBrush" Value="#2e2e2e"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style Selector="ToggleButton.dock-toggle:disabled /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#4a4a4a"/>
			<Setter Property="BorderBrush" Value="#3a3a3a"/>
			<Setter Property="Foreground" Value="#808080"/>
		</Style>
		<Style Selector="ToggleButton.dock-toggle:checked /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#ad76ea"/>
			<Setter Property="BorderBrush" Value="#2e2e2e"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<Style Selector="Border.dock-card">
			<Setter Property="Width" Value="300"/>
			<Setter Property="Margin" Value="0 0 6 6"/>
			<Setter Property="Background" Value="#F02b2b2b"/>
			<Setter Property="BoxShadow" Value="0 4 12 2 #80000000"/>
			<Setter Property="BorderBrush" Value="#5f5f5f"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="5"/>
			<Setter Property="ClipToBounds" Value="True"/>
			<Setter Property="VerticalAlignment" Value="Bottom"/>
		</Style>
		<Style Selector="Border.dock-card Button">
			<Setter Property="Height" Value="20"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="Padding" Value="6 0"/>
			<Setter Property="FontSize" Value="11"/>
		</Style>
		<Style Selector="Border.dock-card Button /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="VerticalAlignment" Value="Stretch"/>
		</Style>
		<Style Selector="Border.dock-card-header">
			<Setter Property="Background" Value="Gray"/>
			<Setter Property="Padding" Value="8 4"/>
		</Style>
		<Style Selector="Border.dock-card-header TextBlock">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Foreground" Value="White"/>
		</Style>
	</UserControl.Styles>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="Auto" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<Grid Grid.Row="0" Grid.Column="1" x:Name="ImagePanel" Background="#454545" />

		<Border Grid.Row="0" Grid.Column="1" ZIndex="5" IsVisible="{Binding IsFramePending}" IsHitTestVisible="False"
				HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0 0 0 60"
				Background="#B0000000" CornerRadius="5" Padding="12 6">
			<TextBlock Text="This frame has not been measured yet" Foreground="White" FontSize="13" />
		</Border>

		<Border Grid.Row="0" Grid.Column="1" ZIndex="10"
		        HorizontalAlignment="Right" VerticalAlignment="Bottom">
			<StackPanel Orientation="Horizontal">
				<Border Classes="dock-card" IsVisible="{Binding #ImageElementsToggle.IsChecked}">
					<DockPanel>
						<Border DockPanel.Dock="Top" Classes="dock-card-header">
							<TextBlock Text="Image elements"/>
						</Border>
						<ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
							<ContentControl x:Name="RegionContent" Margin="6"/>
						</ScrollViewer>
					</DockPanel>
				</Border>
				<Border Classes="dock-card" IsVisible="{Binding #MultiChannelViewerToggle.IsChecked}">
					<DockPanel>
						<Border DockPanel.Dock="Top" Classes="dock-card-header">
							<TextBlock Text="Multi channel viewer"/>
						</Border>
						<ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
							<StackPanel Margin="6" Spacing="6">
								<ContentControl x:Name="MultiChannelConfig"/>
								<StackPanel x:Name="MultiChannelContrastExpander" IsVisible="False" Spacing="4">
									<Border BorderBrush="#5f5f5f" BorderThickness="0 1 0 0" Padding="0 6 0 0">
										<TextBlock Text="Contrast" FontSize="12" Foreground="White"/>
									</Border>
									<ContentControl x:Name="MultiChannelContrastHost"/>
								</StackPanel>
							</StackPanel>
						</ScrollViewer>
					</DockPanel>
				</Border>
			</StackPanel>
		</Border>

		<Border Grid.Row="0" Grid.Column="0" x:Name="ImageUtilities" Width="44"
		        Background="#3a3a3a" BorderBrush="#2e2e2e" BorderThickness="0 0 1 0">
			<StackPanel x:Name="imageControls" Orientation="Vertical" Spacing="6" Margin="0 8 0 0">
				<Button x:Name="selectDotButton" Click="OnDotToggled" ToolTip.Tip="Select ROI's. Press once on top of image to add ROI. Ctrl + '+' to increase size, Ctrl + '-' to decrease size. Press Enter to finish selection.">
					<Image Source="/Assets/icons/circle.png"/>
				</Button>
				<Button x:Name="selectLineButton" Click="OnDotToggled" ToolTip.Tip="Line element. Press on selected image to start adding a line element. Ctrl + '+' to increase size, Ctrl + '-' to decrease size. Press Enter to finish selection.">
					<Image Source="/Assets/icons/line.png"/>
				</Button>
				<ToggleButton x:Name="IsMultiViewEnabled" IsChecked="{Binding MultiViewEnabled}" Click="OnChangeToMultiChannel" ToolTip.Tip="Multi channel view. Click to enable composite multi channel view. Click again to disable.">
					<Image Source="/Assets/icons/multichannel.png"/>
				</ToggleButton>
			</StackPanel>
		</Border>

		<DockPanel Grid.Row="1" Grid.ColumnSpan="2" Height="25" VerticalAlignment="Bottom"  Background="Gray">
			<Grid DockPanel.Dock="Left" ColumnDefinitions="Auto, *, Auto" HorizontalAlignment="Stretch">
				<StackPanel Grid.Column="0" Orientation="Horizontal">
					<Button Height="26" Padding="0 3 0 3" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Width="100" BorderBrush="#2e2e2e" VerticalAlignment="Bottom" Click="OnResetView" > Reset view </Button>
				</StackPanel>
				<StackPanel ZIndex="0" Margin="0" x:Name="ImageProgress" Grid.Column="1"   HorizontalAlignment="Center" Orientation="Horizontal">
					<Slider Padding="5 0 5 0" ClipToBounds="False" ZIndex="1" Height="40" Margin="0 0 0 0"  VerticalAlignment="Center" IsEnabled="{Binding !ShowLiveView}" IsVisible="{Binding !IsLiveView}"  x:Name="imageSlider" Minimum="0" TickFrequency="1" IsSnapToTickEnabled="True"  Maximum="{Binding LastFrameIndex}" Value="{Binding SelectedFrame, Mode=TwoWay}"   Width="390">
						<Slider.Styles>

							<Style Selector="Slider:horizontal">
								<Setter Property="MinWidth" Value="40" />
								<Setter Property="MinHeight" Value="20" />

								<Style Selector="^ Track">
									<Style Selector="^ #PART_DecreaseButton Border">
										<Setter Property="CornerRadius" Value="10 0 0 10 "/>
										<Setter Property="Height" Value="14"/>
										<Setter Property="Background" Value="#ad76ea"/>
										<Setter Property="ZIndex" Value="0"/>

									</Style>

									<Style Selector="^ #PART_IncreaseButton Border">
										<Setter Property="CornerRadius" Value="0 10 10 0"/>
										<Setter Property="Height" Value="14"/>
										<Setter Property="Background" Value="#e0e0e0"/>
										<Setter Property="ZIndex" Value="0"/>

									</Style>

									<Style Selector="^ Thumb">
										<Setter Property="Height" Value="10"/>
										<Setter Property="Width" Value="10"/>
										<Setter Property="BorderBrush" Value="#2e2e2e"/>
										<Setter Property="BorderThickness" Value="1"/>
										<Setter Property="ZIndex" Value="1"/>
										<Setter Property="ClipToBounds" Value="False"/>
										<Setter Property="Template">
											<Setter.Value>
												<ControlTemplate>
													<Canvas ZIndex="1" ClipToBounds="False"  Width="5" Height="5">
														<Ellipse ZIndex="1" ClipToBounds="False" Stroke="Black" StrokeThickness="1" Fill="LightGray" Width="15" Height="15" Canvas.Top="-5" Canvas.Left="-6">

														</Ellipse>
													</Canvas>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
									</Style>

									<Style Selector="^ Thumb:pointerover">
										<Setter Property="Height" Value="10"/>
										<Setter Property="Width" Value="10"/>
										<Setter Property="BorderBrush" Value="LightGray"/>
										<Setter Property="Background" Value="White"/>
										<Setter Property="BorderThickness" Value="1"/>
									</Style>
								</Style>
								<Style Selector="^ Track:disabled">
									<Style Selector="^ #PART_DecreaseButton Border">
										<Setter Property="CornerRadius" Value="10 0 0 10 "/>
										<Setter Property="Height" Value="14"/>
										<Setter Property="Background" Value="DarkGray"/>
										<Setter Property="ZIndex" Value="0"/>

									</Style>

									<Style Selector="^ #PART_IncreaseButton Border">
										<Setter Property="CornerRadius" Value="0 10 10 0 "/>
										<Setter Property="Height" Value="14"/>
										<Setter Property="Background" Value="DarkGray"/>
										<Setter Property="ZIndex" Value="0"/>
									</Style>

									<Style Selector="^ Thumb">
										<Setter Property="Height" Value="10"/>
										<Setter Property="Width" Value="10"/>
										<Setter Property="ZIndex" Value="1"/>
										<Setter Property="ClipToBounds" Value="False"/>
										<Setter Property="BorderBrush" Value="#2e2e2e"/>
										<Setter Property="BorderThickness" Value="1"/>
										<Setter Property="Template">
											<Setter.Value>
												<ControlTemplate>
													<Canvas ZIndex="1" ClipToBounds="False"  Width="5" Height="5">
														<Ellipse ZIndex="1" ClipToBounds="False" Stroke="Black" StrokeThickness="1" Fill="DarkGray" Width="15" Height="15" Canvas.Top="-5" Canvas.Left="-6">

														</Ellipse>
													</Canvas>
												</ControlTemplate>
											</Setter.Value>
										</Setter>
									</Style>
								</Style>
							</Style>
						</Slider.Styles>
					</Slider>
					<TextBlock Background="Transparent" ZIndex="0" Margin="2 0 0 0" Width="90" VerticalAlignment="Center" Text="{Binding AcquisitionProgress}"  FontSize="10"  > </TextBlock>
					<CheckBox Margin="0 0 0 0" VerticalAlignment="Center" IsChecked="{Binding ShowLiveView}" IsVisible="{Binding !IsLiveView}"  FontSize="10"   >
						Show last
					</CheckBox>

				</StackPanel>

				<StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 0 4 0">
					<StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Orientation="Horizontal" IsVisible="{Binding !IsLiveView}">
						<TextBlock VerticalAlignment="Center"> Stage position: </TextBlock>
						<ComboBox Padding="3 0 3 0" MinHeight="15" Margin="2 0 0 0" FontSize="10" Height="25" SelectedItem="{Binding SelectedStagePosition}" BorderBrush="#2e2e2e" ItemsSource="{Binding AvailableStagePositions}" DisplayMemberBinding="{Binding Name}" Width="80"></ComboBox>
					</StackPanel>
					<ToggleButton x:Name="ImageElementsToggle" Classes="dock-toggle" IsChecked="False" Content="Image elements"/>
					<ToggleButton x:Name="MultiChannelViewerToggle" Classes="dock-toggle" IsChecked="False" Content="Multi channel viewer" IsEnabled="{Binding !IsLiveView}"/>
				</StackPanel>
			</Grid>
		</DockPanel>

	</Grid>

</UserControl>
