<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ImagerAvalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="250" d:DesignHeight="150"
             x:Class="ImagerAvalonia.Views.StageControlPanelView"
             x:DataType="vm:StageControlPanelViewModel">

	<UserControl.Styles>
		<Style Selector="Button.stage-move">
			<Setter Property="Width" Value="26"/>
			<Setter Property="Height" Value="26"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="1"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="Background" Value="Gainsboro"/>
			<Setter Property="CornerRadius" Value="4"/>
			<Setter Property="BorderBrush" Value="#2e2e2e"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
		<Style Selector="TextBlock.stage-label">
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="HorizontalAlignment" Value="Center"/>
		</Style>
	</UserControl.Styles>

	<Grid>
		<!-- The available hardware is fixed at startup; when no motorized
		     stage was found the controls are hidden entirely. -->
		<TextBlock Text="No motorized stage found."
		           FontSize="12" Foreground="White"
		           HorizontalAlignment="Center" VerticalAlignment="Center"
		           IsVisible="{Binding !IsStageAvailable}"/>

		<StackPanel Orientation="Horizontal" IsVisible="{Binding IsStageAvailable}"
		            HorizontalAlignment="Center" Margin="0 4 0 2">

			<!-- XY movement -->
			<StackPanel Margin="0 0 12 0">
				<Grid ColumnDefinitions="Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
					<Button Classes="stage-move" Grid.Row="0" Grid.Column="1" Command="{Binding MoveNorth}"> ▲ </Button>
					<Button Classes="stage-move" Grid.Row="1" Grid.Column="0" Command="{Binding MoveWest}"> ◀ </Button>
					<Button Classes="stage-move" Grid.Row="1" Grid.Column="2" Command="{Binding MoveEast}"> ▶ </Button>
					<Button Classes="stage-move" Grid.Row="2" Grid.Column="1" Command="{Binding MoveSouth}"> ▼ </Button>
				</Grid>
				<TextBlock Classes="stage-label" FontSize="10" Text="XY step (μm)" Margin="0 4 0 1"/>
				<NumericUpDown Classes="custom-numeric-style" Minimum="0" Width="92"
				               Value="{Binding XYStep, TargetNullValue=0.0, FallbackValue=0.0}"/>
			</StackPanel>

			<!-- Z movement: the up/down buttons are centered above the
			     step spinner, at the same height as the XY pad. -->
			<StackPanel>
				<Panel Height="84">
					<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
						<Button Classes="stage-move" Command="{Binding MoveUp}"> ▲ </Button>
						<Button Classes="stage-move" Command="{Binding MoveDown}"> ▼ </Button>
					</StackPanel>
				</Panel>
				<TextBlock Classes="stage-label" FontSize="10" Text="Z step (μm)" Margin="0 4 0 1"/>
				<NumericUpDown Classes="custom-numeric-style" Minimum="0" Width="92"
				               Value="{Binding ZStep, TargetNullValue=0.0, FallbackValue=0.0}"/>
			</StackPanel>

		</StackPanel>
	</Grid>

</UserControl>
