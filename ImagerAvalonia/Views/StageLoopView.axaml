<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="450"
			 
             xmlns:vm="clr-namespace:ImagerAvalonia.ViewModels"
             x:Class="ImagerAvalonia.Views.StageLoopView"
			 x:DataType="vm:StageLoopViewModel">






	<UserControl.Styles >

		<Style Selector="Border.header-border">
			<Setter Property="Background">
				<Setter.Value>
					<SolidColorBrush Color="#454545"  />
				</Setter.Value>
			</Setter>
			<Setter Property="BorderBrush" Value="Black" />
			<Setter Property="BorderThickness" Value="0.5" />
			<Setter Property="MaxWidth" Value="750" />
			<Setter Property="Padding" Value="10" />
		</Style>

		<Style Selector="TextBlock.header">
			<Setter Property="FontSize" Value="18" />
			<Setter Property="FontWeight" Value="Bold" />
		</Style>


		



	</UserControl.Styles>



	<StackPanel Orientation="Vertical"
				Width="600"
			    HorizontalAlignment="Left"
				Background="#454545">
		<StackPanel Orientation="Vertical"
					Spacing="4">
			<TextBlock Text="Stage loop" Classes="header" />
		</StackPanel>
		

		<ScrollViewer Height="250">
		<Border    PointerEntered="Border_PointerEnter" Focusable="True" KeyDown="OnKeyDown" Background="#454545" Classes="thin">


			<DataGrid HorizontalAlignment="Left" Width="262"  ItemsSource="{Binding XYPositions}" 
					  AutoGenerateColumns="False" IsReadOnly="False"
					  GridLinesVisibility="All"
					  BorderThickness="1" BorderBrush="Gray" ColumnWidth="Auto"
					  SelectedIndex="{Binding CurrentSelectedIndex}"
					  CanUserSortColumns="False"
					  KeyDown="OnRowPasteClipboardContent">
				<DataGrid.Styles>
					<Style Selector="DataGridCell">
						<Setter Property="FontSize" Value="10" />
					</Style>
				
				</DataGrid.Styles>
				<DataGrid.Columns >
					<DataGridTextColumn Binding="{Binding XPos}">
						<DataGridTextColumn.Header>
							<TextBlock Text="X μm"
									   FontSize="10"
									   TextWrapping="Wrap"
									   TextAlignment="Center"
									   HorizontalAlignment="Left"
									   VerticalAlignment="Center"
									   Margin="-5 0 5 0"/>
						</DataGridTextColumn.Header>
					</DataGridTextColumn>
					<DataGridTextColumn  Binding="{Binding YPos}">
						<DataGridTextColumn.Header>
							<TextBlock Text="Y μm"
									   FontSize="10"
									   TextWrapping="Wrap"
									   TextAlignment="Center"
									   HorizontalAlignment="Left"
									   VerticalAlignment="Center"
									   Margin="-5 0 5 0"/>
						</DataGridTextColumn.Header>

					</DataGridTextColumn>
					<DataGridTextColumn Binding="{Binding ZPos}">

						<DataGridTextColumn.Header>
							<TextBlock Text="Z μm"
									   FontSize="10"
									   TextWrapping="Wrap"
									   TextAlignment="Center"
									   HorizontalAlignment="Left"
									   VerticalAlignment="Center"
									   Margin="-5 0 5 0"/>
						</DataGridTextColumn.Header>
					</DataGridTextColumn>
					
					<DataGridCheckBoxColumn Width="43" Binding="{Binding IsPFSEnabled}">

						<DataGridCheckBoxColumn.Header>
							<TextBlock Text="AF"
									   FontSize="10"
									   TextWrapping="Wrap"
									   TextAlignment="Center"
									   HorizontalAlignment="Left"
									   VerticalAlignment="Center"
									   Margin="-5 0 5 0"/>
						</DataGridCheckBoxColumn.Header>
						
					</DataGridCheckBoxColumn>
					<DataGridTextColumn   Binding="{Binding PFSOffset}">


							<DataGridTextColumn.Header>
								<TextBlock Text="Offset"
										   FontSize="10"
										   TextWrapping="Wrap"
										   TextAlignment="Center"
										   HorizontalAlignment="Left"
										   VerticalAlignment="Center"
										   Margin="-5 0 5 0"/>
							</DataGridTextColumn.Header>
					</DataGridTextColumn>

					<DataGridTextColumn Width="50" Binding="{Binding Name}">

						<DataGridTextColumn.Header>
							<TextBlock Text="Name"
									   FontSize="10"
									   TextWrapping="Wrap"
									   TextAlignment="Center"
									   HorizontalAlignment="Left"
									   VerticalAlignment="Center"
									   Margin="-5 0 5 0"/>
						</DataGridTextColumn.Header>
						
					</DataGridTextColumn>


				</DataGrid.Columns>
			</DataGrid>

		</Border>
		</ScrollViewer>


		<Grid ColumnDefinitions="143,140" RowDefinitions="30,30,30">
			<Button Grid.Row="0" Grid.Column="0" Padding="0 3 0 3" 
				   VerticalContentAlignment="Center"   
				   Command="{Binding GetStagePosition}" 
				   Height="25" 
				   Width="120"  
				   BorderBrush="#2e2e2e" >
				  <TextBlock Text="Add current position"
				    Foreground="White"
					FontSize="10"
					TextAlignment="Center"/>
			</Button>
			<Button Grid.Row="1" Grid.Column="0" Padding="0 3 0 3" 
				   VerticalContentAlignment="Center"   
				   Command="{Binding  SetToCurrentStagePosition}" 
				   Height="25" 
				   Width="120"  
				   BorderBrush="#2e2e2e" 
				   Foreground="White">  
				
				<TextBlock Text="Set to current position"
				    Foreground="White"
					FontSize="10"
					TextAlignment="Center"/>
			</Button>
			<Button Grid.Row="2" Grid.Column="0" Padding="0 3 0 3" 
				   VerticalContentAlignment="Center"   
				   Command="{Binding MoveUp}" 
				   Height="25" 
				   Width="120"  
				   BorderBrush="#2e2e2e" 
				   Foreground="White">

					<TextBlock Text="Move Up"
				    Foreground="White"
					FontSize="10"
					TextAlignment="Center"/>
			</Button>
			<Button Grid.Row="0" Grid.Column="1" Padding="0 3 0 3"  
			       Command="{Binding DeleteSelectedItem}" 
				   Height="25" 
				   TextBlock.TextAlignment="Center" 
				   Width="120"  
				   BorderBrush="#2e2e2e" 
				   Foreground="White">
					<TextBlock Text="Delete selected"
				    Foreground="White"
					FontSize="10"
					TextAlignment="Center"/>			   
			</Button>
			<Button  Grid.Row="1" Grid.Column="1" Padding="0 3 0 3"   
				   VerticalContentAlignment="Center"   
				   Command="{Binding SetStagePosition}" 
				   Height="25" 
				   FontSize="6" 
				   TextBlock.TextAlignment="Center" 
				   Width="120"  
				   BorderBrush="#2e2e2e" 
				   Foreground="White">
					<TextBlock Text="Move stage to selected"
				    Foreground="White"
					FontSize="10"
					TextAlignment="Center"/>	
			</Button>
			<Button  Grid.Row="2" Grid.Column="1" Padding="0 3 0 3"   
			    Command="{Binding MoveDown}" 
				VerticalContentAlignment="Center"   
				Height="25" 
				TextBlock.TextAlignment="Center" 
				Width="120"  
				BorderBrush="#2e2e2e" Foreground="White">
				<TextBlock Text="Move down"
				    Foreground="White"
					FontSize="10"
					TextAlignment="Center"/>	
			</Button>


		</Grid>

		<StackPanel Margin="0 10 0 0" Orientation="Horizontal">
			<TextBlock
					Margin="1 0 0 0"
			        VerticalAlignment="Center"
					Foreground="White"
					FontSize="10"
					TextAlignment="Center">
				Positions from template:
			</TextBlock>
		<Button Margin="8 0 0 0" Click="OpenStageTemplatePanel"	 Height="25" FontSize="10" TextBlock.TextAlignment="Center" Width="50"  
		  BorderBrush="#2e2e2e" Foreground="White">
			<TextBlock Text="Open"
				    Foreground="White"
					FontSize="10"
					TextAlignment="Center"/>
  
		</Button>

		</StackPanel>



			


		<StackPanel Margin="2 0 0 0" Width="110" HorizontalAlignment="Left" Orientation="Horizontal">
			<TextBlock Foreground="White"  FontSize="10" HorizontalAlignment="Left" VerticalAlignment = "Center" Text="Parameters from program" Width="130"/>
			<CheckBox IsChecked="{Binding FromProgramId}" Margin="20 0 0 0">
				
			</CheckBox>

		</StackPanel>	
		
		<StackPanel IsEnabled="{Binding FromProgramId}" Margin="2 0 0 0" Width="110" HorizontalAlignment="Left" Orientation="Horizontal">
			<TextBlock Foreground="White"  FontSize="10" HorizontalAlignment="Left" VerticalAlignment = "Center" Text="Program ID" Width="40"/>

			<ComboBox BorderThickness="0.5" HorizontalAlignment="Center" FontSize="10" Padding="0" MinHeight="20" Height="20" DisplayMemberBinding="{Binding SmartProgramID}"  VerticalAlignment = "Center"  Margin="20 0 0 0" SelectedItem="{Binding SelectedProgramId}" ItemsSource="{Binding SmartPrograms}" Width="110">
				<ComboBox.Styles>
					<Style Selector="ComboBox ContentPresenter">
						<Setter Property="Margin" Value="5 0 0 0"/>
					</Style>
				</ComboBox.Styles>
			</ComboBox> 
		</StackPanel>

	</StackPanel>


</UserControl>

