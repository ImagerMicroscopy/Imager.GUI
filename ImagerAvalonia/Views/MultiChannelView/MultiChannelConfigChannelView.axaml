<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ImagerAvalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:views="clr-namespace:ImagerAvalonia.Views"
             x:Class="ImagerAvalonia.Views.MultiChannelConfigChannelView"
			 x:DataType="vm:MultiChannelConfigChannelViewModel">

		<StackPanel Background="Transparent"  Margin="15 0 0 0">

			<Border IsVisible="{Binding !HasSelectedDetection}"
					Background="#F5F6FA"
					BorderBrush="#9AA3B5"
					BorderThickness="1.5"
					CornerRadius="8"
					Height="60"
					Width="170"
					HorizontalAlignment="Left"
					Margin="0 0 0 12"
					DragDrop.AllowDrop="True"
					DragDrop.Drop="OnDrop"
					DragDrop.DragOver="OnDragOver">
				<Border.Styles>
					<Style Selector="Border:pointerover">
						<Setter Property="Background" Value="#EAF3FF"/>
						<Setter Property="BorderBrush" Value="#4C8DFF"/>
					</Style>
				</Border.Styles>
				<StackPanel VerticalAlignment="Center"
							HorizontalAlignment="Center"
							Spacing="4">
					<TextBlock Text="Drop a detection here"
							   FontSize="13"
							   FontWeight="SemiBold"
							   Foreground="#3A3F4B"
							   HorizontalAlignment="Center"/>
					<TextBlock Text="Drag from the experiment tree to bind it"
							   FontSize="10"
							   Foreground="#6B7280"
							   HorizontalAlignment="Center"/>
				</StackPanel>
			</Border>

			<StackPanel IsVisible="{Binding HasSelectedDetection}">

				<Grid Margin="3 0 0 0" ColumnDefinitions="150,20,20">

					<TextBlock FontSize="12" Foreground="Black" Grid.Column="0" Text="Selected Detection"> </TextBlock>

					<Button Click="OnClearDropClick"
							FontSize="14"
							Grid.Column="2"
							Margin="10 0 0 0"
							Width="20" Height="20"
							Padding="0"
							Background="Transparent"
							BorderThickness="0">
						<Button.Styles>
							<Style Selector="Button:pointerover /template/ ContentPresenter">
								<Setter Property="Background" Value="Transparent"/>
							</Style>
						</Button.Styles>
						<TextBlock Text="✕"
								   FontSize="13"
								   FontWeight="Bold"
								   Foreground="#E5484D"
								   HorizontalAlignment="Center"
								   VerticalAlignment="Center"/>
					</Button>
				</Grid>

				<Grid ColumnDefinitions="80,90"  Margin="20 0 0 0" Width="170">
					<TextBlock Grid.Column="0"  Foreground="Black"  FontSize="8" HorizontalAlignment="Left" VerticalAlignment = "Center" Text="Acquisition" Width="80"/>
					<ComboBox HorizontalAlignment="Right" Grid.Column="1" ItemsSource="{Binding FilteredAcquisitions}" DisplayMemberBinding="{Binding Name}" SelectedItem="{Binding AcquisitionInput}"   BorderThickness="0.5" FontSize="8" Padding="0" MinHeight="20" Height="20"  VerticalAlignment = "Center"  Margin="-10 0 0 0" Width="90">
						<ComboBox.Styles>
							<Style Selector="ComboBox ContentPresenter">
								<Setter Property="Margin" Value="5 0 0 0"/>
							</Style>
						</ComboBox.Styles>
					</ComboBox>
				</Grid>

				<Grid ColumnDefinitions="80,90"  Margin="20 0 0 0" Width="170">
					<TextBlock Grid.Column="0"  Foreground="Black"  FontSize="8" HorizontalAlignment="Left" VerticalAlignment = "Center" Text="Detector" Width="80"/>
					<ComboBox HorizontalAlignment="Right" Grid.Column="1" ItemsSource="{Binding DefinedDetectors}" DisplayMemberBinding="{Binding Name}" SelectedItem="{Binding DetectorInput}"  BorderThickness="0.5" FontSize="8" Padding="0" MinHeight="20" Height="20"  VerticalAlignment = "Center"  Margin="-10 0 0 0" Width="90">
						<ComboBox.Styles>
							<Style Selector="ComboBox ContentPresenter">
								<Setter Property="Margin" Value="5 0 0 0"/>
							</Style>
						</ComboBox.Styles>
					</ComboBox>
				</Grid>
			</StackPanel>
		</StackPanel>

</UserControl>
