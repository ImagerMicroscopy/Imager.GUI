<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="using:ImagerAvalonia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ImagerAvalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ImagerAvalonia.Views.MultiChannelConfigView"
			 xmlns:views="clr-namespace:ImagerAvalonia.Views"
			 x:DataType="vm:MultiChannelViewModel">

    <UserControl.DataTemplates>
        <DataTemplate DataType="{x:Type vm:MultiChannelConfigChannelViewModel}">
            <views:MultiChannelConfigChannelView />
        </DataTemplate>
    </UserControl.DataTemplates>





    <StackPanel Orientation="Vertical">


	    <ItemsControl Background="Transparent" ItemsSource="{Binding AvailableChannels}">
            <ItemsControl.ItemTemplate>
				<DataTemplate>
                    <StackPanel Orientation="Vertical" Margin="0 0 0 8">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                            <TextBlock Grid.Column="0" Foreground="White" FontSize="13"
                                       VerticalAlignment="Center" Text="{Binding ChannelName}"/>
                            <Button Grid.Column="1" Command="{Binding OnChannelAdded}" Width="50" FontSize="11">Add</Button>
                            <Button Grid.Column="2" Command="{Binding OnChannelRemoved}" Width="60" FontSize="11">Remove</Button>
                        </Grid>
                        <ContentControl Margin="0 4 0 0" IsVisible="{Binding IsEnabled}" Content="{Binding ConfigChannelViewModel}" />
                    </StackPanel>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

    </StackPanel>
</UserControl>
