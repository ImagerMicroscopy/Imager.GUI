<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ImagerAvalonia.Views.MultiChannelContrastView"
             xmlns:vm="clr-namespace:ImagerAvalonia.ViewModels"
             xmlns:rs="using:RangeSlider.Avalonia.Controls"

             x:DataType="vm:MultiChannelContrastViewModel">





<StackPanel Margin="0 20 0 0" Width="280" x:Name="ColorSliderPanel" Spacing="2">

    <StackPanel Margin="0 -10 0 0"  Width="280" Orientation="Vertical" Spacing="5">
       <Grid Margin="30 0 0 0" ColumnDefinitions="20,180">
       <TextBlock ClipToBounds="False" Foreground="Black" Grid.Column="0" Text="Red" FontSize="10"></TextBlock>
       <rs:RangeSlider  Grid.Column="1" MoveWholeRange="True" TickFrequency="1" IsSnapToTickEnabled="True" Width="180" LowerSelectedValue="{Binding RedValueMin}" UpperSelectedValue="{Binding RedValueMax}" Orientation="Horizontal" Minimum="0" Maximum="65536" IsThumbOverlap="True">
            <rs:RangeSlider.Resources>
				    <x:Double x:Key="SliderHorizontalThumbWidth">10</x:Double>
				    <x:Double x:Key="SliderHorizontalThumbHeight">10</x:Double>

		    </rs:RangeSlider.Resources>
            <rs:RangeSlider.Styles>
                <Style Selector="rs|RangeSlider:horizontal">



                    <Style Selector="^ /template/ #PART_BackgroundButton:disabled /template/ Border">
                        <Setter Property="Background" Value="#2e2e2e"/>
                        <Setter Property="Height" Value="2"/>
                    </Style>

                    <Style Selector="^ /template/ #PART_ForegroundButton /template/ Border">
                        <Setter Property="Background" Value="#ad76ea"/>
                        <Setter Property="Height" Value="2"/>
                    </Style>

                    <Style Selector="^ /template/ #PART_ForegroundButton:disabled /template/ Border">
                        <Setter Property="Background" Value="#2e2e2e"/>
                        <Setter Property="Height" Value="2"/>
                    </Style>

                    <Style Selector="^ /template/ Thumb">
                        <Setter Property="Background" Value="#ad76ea"/>
                    </Style>

                    <Style Selector="^ /template/ Thumb:pointerover">
                        <Setter Property="Background" Value="LightGray"/>
                    </Style>

                </Style>
            </rs:RangeSlider.Styles>
        </rs:RangeSlider>
        </Grid>

        <Grid Margin="10 -20 0 0" HorizontalAlignment="Center"  ColumnDefinitions="35,140,35">
            <TextBlock Foreground="Black" Grid.Column="0" Text="{Binding RedValueMin}" FontSize="8"></TextBlock>
            <TextBlock Foreground="Black" Grid.Column="2" Text="{Binding RedValueMax}" FontSize="8"></TextBlock>
        </Grid>
    </StackPanel>
     <StackPanel  Margin="0 -10 0 0"   Width="280" Orientation="Vertical" Spacing="5">
       <Grid Margin="30 0 0 0" ColumnDefinitions="20,180">
       <TextBlock ClipToBounds="False" Foreground="Black" Grid.Column="0" Text="Green" FontSize="10"></TextBlock>
       <rs:RangeSlider  Grid.Column="1" MoveWholeRange="True" TickFrequency="1" IsSnapToTickEnabled="True"  Width="180" LowerSelectedValue="{Binding GreenValueMin}" UpperSelectedValue="{Binding GreenValueMax}" Orientation="Horizontal" Minimum="0" Maximum="65536" IsThumbOverlap="True">
            <rs:RangeSlider.Resources>
				    <x:Double x:Key="SliderHorizontalThumbWidth">10</x:Double>
				    <x:Double x:Key="SliderHorizontalThumbHeight">10</x:Double>

		    </rs:RangeSlider.Resources>
            <rs:RangeSlider.Styles>
                <Style Selector="rs|RangeSlider:horizontal">



                    <Style Selector="^ /template/ #PART_BackgroundButton:disabled /template/ Border">
                        <Setter Property="Background" Value="#2e2e2e"/>
                        <Setter Property="Height" Value="2"/>
                    </Style>

                    <Style Selector="^ /template/ #PART_ForegroundButton /template/ Border">
                        <Setter Property="Background" Value="#ad76ea"/>
                        <Setter Property="Height" Value="2"/>
                    </Style>

                    <Style Selector="^ /template/ #PART_ForegroundButton:disabled /template/ Border">
                        <Setter Property="Background" Value="#2e2e2e"/>
                        <Setter Property="Height" Value="2"/>
                    </Style>

                    <Style Selector="^ /template/ Thumb">
                        <Setter Property="Background" Value="#ad76ea"/>
                    </Style>

                    <Style Selector="^ /template/ Thumb:pointerover">
                        <Setter Property="Background" Value="LightGray"/>
                    </Style>

                </Style>
            </rs:RangeSlider.Styles>
        </rs:RangeSlider>
        </Grid>

        <Grid Margin="10 -20 0 0" HorizontalAlignment="Center"  ColumnDefinitions="35,140,35">
            <TextBlock Foreground="Black" Grid.Column="0" Text="{Binding GreenValueMin}" FontSize="8"></TextBlock>
            <TextBlock Foreground="Black" Grid.Column="2" Text="{Binding GreenValueMax}" FontSize="8"></TextBlock>
        </Grid>
    </StackPanel>
    <StackPanel  Margin="0 -10 0 0"   Width="280" Orientation="Vertical" Spacing="5">
       <Grid Margin="30 0 0 0" ColumnDefinitions="20,180">
       <TextBlock ClipToBounds="False" Foreground="Black" Grid.Column="0" Text="Blue" FontSize="10"></TextBlock>

           <rs:RangeSlider Grid.Column="1"  MoveWholeRange="True" TickFrequency="1" IsSnapToTickEnabled="True" Width="180" LowerSelectedValue="{Binding BlueValueMin}" UpperSelectedValue="{Binding BlueValueMax}" Orientation="Horizontal" Minimum="0" Maximum="65536" IsThumbOverlap="True">
                  <rs:RangeSlider.Resources>
				        <x:Double x:Key="SliderHorizontalThumbWidth">10</x:Double>
				        <x:Double x:Key="SliderHorizontalThumbHeight">10</x:Double>
		        </rs:RangeSlider.Resources>
                <rs:RangeSlider.Styles>
                    <Style Selector="rs|RangeSlider:horizontal">



                        <Style Selector="^ /template/ #PART_BackgroundButton:disabled /template/ Border">
                            <Setter Property="Background" Value="#2e2e2e"/>
                            <Setter Property="Height" Value="2"/>
                        </Style>

                        <Style Selector="^ /template/ #PART_ForegroundButton /template/ Border">
                            <Setter Property="Background" Value="#ad76ea"/>
                            <Setter Property="Height" Value="2"/>
                        </Style>

                        <Style Selector="^ /template/ #PART_ForegroundButton:disabled /template/ Border">
                            <Setter Property="Background" Value="#2e2e2e"/>
                            <Setter Property="Height" Value="2"/>
                        </Style>

                        <Style Selector="^ /template/ Thumb">
                            <Setter Property="Background" Value="#ad76ea"/>
                        </Style>

                        <Style Selector="^ /template/ Thumb:pointerover">
                            <Setter Property="Background" Value="LightGray"/>
                        </Style>

                    </Style>
                </rs:RangeSlider.Styles>
            </rs:RangeSlider>
        </Grid>
        <Grid Margin="10 -20 0 0" HorizontalAlignment="Center" ColumnDefinitions="35,140,35">
            <TextBlock Foreground="Black" Grid.Column="0" Text="{Binding BlueValueMin}" FontSize="8"></TextBlock>
            <TextBlock Foreground="Black" Grid.Column="2" Text="{Binding BlueValueMax}" FontSize="8"></TextBlock>
        </Grid>

    </StackPanel>

    <StackPanel  Margin="0 -10 0 0"   Width="280" Orientation="Vertical" Spacing="5">
       <Grid Margin="30 0 0 0" ColumnDefinitions="20,180">
       <TextBlock ClipToBounds="False" Foreground="Black" Grid.Column="0" Text="Yellow" FontSize="10"></TextBlock>

           <rs:RangeSlider Grid.Column="1"  MoveWholeRange="True" TickFrequency="1" IsSnapToTickEnabled="True" Width="180" LowerSelectedValue="{Binding YellowValueMin}" UpperSelectedValue="{Binding YellowValueMax}" Orientation="Horizontal" Minimum="0" Maximum="65536" IsThumbOverlap="True">
                  <rs:RangeSlider.Resources>
				        <x:Double x:Key="SliderHorizontalThumbWidth">10</x:Double>
				        <x:Double x:Key="SliderHorizontalThumbHeight">10</x:Double>
		        </rs:RangeSlider.Resources>
                <rs:RangeSlider.Styles>
                    <Style Selector="rs|RangeSlider:horizontal">



                        <Style Selector="^ /template/ #PART_BackgroundButton:disabled /template/ Border">
                            <Setter Property="Background" Value="#2e2e2e"/>
                            <Setter Property="Height" Value="2"/>
                        </Style>

                        <Style Selector="^ /template/ #PART_ForegroundButton /template/ Border">
                            <Setter Property="Background" Value="#ad76ea"/>
                            <Setter Property="Height" Value="2"/>
                        </Style>

                        <Style Selector="^ /template/ #PART_ForegroundButton:disabled /template/ Border">
                            <Setter Property="Background" Value="#2e2e2e"/>
                            <Setter Property="Height" Value="2"/>
                        </Style>

                        <Style Selector="^ /template/ Thumb">
                            <Setter Property="Background" Value="#ad76ea"/>
                        </Style>

                        <Style Selector="^ /template/ Thumb:pointerover">
                            <Setter Property="Background" Value="LightGray"/>
                        </Style>

                    </Style>
                </rs:RangeSlider.Styles>
            </rs:RangeSlider>
        </Grid>
        <Grid Margin="10 -20 0 0" HorizontalAlignment="Center" ColumnDefinitions="35,140,35">
            <TextBlock Foreground="Black" Grid.Column="0" Text="{Binding YellowValueMin}" FontSize="8"></TextBlock>
            <TextBlock Foreground="Black" Grid.Column="2" Text="{Binding YellowValueMax}" FontSize="8"></TextBlock>
        </Grid>

    </StackPanel>

    <StackPanel  Margin="0 -10 0 0"   Width="280" Orientation="Vertical" Spacing="5">
       <Grid Margin="30 0 0 0" ColumnDefinitions="20,180">
       <TextBlock ClipToBounds="False" Foreground="Black" Grid.Column="0" Text="Transmission" FontSize="10"></TextBlock>

           <rs:RangeSlider Grid.Column="1"  MoveWholeRange="True" TickFrequency="1" IsSnapToTickEnabled="True" Width="180" LowerSelectedValue="{Binding TransmissionValueMin}" UpperSelectedValue="{Binding TransmissionValueMax}" Orientation="Horizontal" Minimum="0" Maximum="65536" IsThumbOverlap="True">
                  <rs:RangeSlider.Resources>
				        <x:Double x:Key="SliderHorizontalThumbWidth">10</x:Double>
				        <x:Double x:Key="SliderHorizontalThumbHeight">10</x:Double>
		        </rs:RangeSlider.Resources>
                <rs:RangeSlider.Styles>
                    <Style Selector="rs|RangeSlider:horizontal">



                        <Style Selector="^ /template/ #PART_BackgroundButton:disabled /template/ Border">
                            <Setter Property="Background" Value="#2e2e2e"/>
                            <Setter Property="Height" Value="2"/>
                        </Style>

                        <Style Selector="^ /template/ #PART_ForegroundButton /template/ Border">
                            <Setter Property="Background" Value="#ad76ea"/>
                            <Setter Property="Height" Value="2"/>
                        </Style>

                        <Style Selector="^ /template/ #PART_ForegroundButton:disabled /template/ Border">
                            <Setter Property="Background" Value="#2e2e2e"/>
                            <Setter Property="Height" Value="2"/>
                        </Style>

                        <Style Selector="^ /template/ Thumb">
                            <Setter Property="Background" Value="#ad76ea"/>
                        </Style>

                        <Style Selector="^ /template/ Thumb:pointerover">
                            <Setter Property="Background" Value="LightGray"/>
                        </Style>

                    </Style>
                </rs:RangeSlider.Styles>
            </rs:RangeSlider>
        </Grid>
        <Grid Margin="10 -20 0 0" HorizontalAlignment="Center" ColumnDefinitions="35,140,35">
            <TextBlock Foreground="Black" Grid.Column="0" Text="{Binding TransmissionValueMin}" FontSize="8"></TextBlock>
            <TextBlock Foreground="Black" Grid.Column="2" Text="{Binding TransmissionValueMax}" FontSize="8"></TextBlock>
        </Grid>

    </StackPanel>



</StackPanel> 

</UserControl>
