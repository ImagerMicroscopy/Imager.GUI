<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ImagerAvalonia.ViewModels"
             mc:Ignorable="d"
             x:Class="ImagerAvalonia.Views.AcquisitionsPanelView"
             x:DataType="vm:MainViewModel">
	<UserControl.Styles>
		<!-- Give the detector tabs a distinct tab-panel look: darker tab
		     headers, the purple selected gradient, and a bordered, darker
		     content area that reads as the tab body. -->
		<Style Selector="TabControl.detector-tabs TabItem">
			<Setter Property="Background" Value="#2e2e2e"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Padding" Value="10 4"/>
			<Setter Property="MinHeight" Value="24"/>
			<Setter Property="BorderThickness" Value="0"/>
		</Style>
		<Style Selector="TabControl.detector-tabs TabItem:pointerover">
			<Setter Property="Background" Value="#5a5a5a"/>
		</Style>
		<Style Selector="TabControl.detector-tabs TabItem:selected">
			<Setter Property="Background">
				<Setter.Value>
					<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
						<GradientStop Color="#ba96e3" Offset="0.0"/>
						<GradientStop Color="#ad76ea" Offset="1.0"/>
					</LinearGradientBrush>
				</Setter.Value>
			</Setter>
			<Setter Property="Foreground" Value="White"/>
		</Style>
		<!-- MainView's TabItem styles paint the header presenter grey; keep it
		     transparent so the tab header background shows through. -->
		<Style Selector="TabControl.detector-tabs TabItem /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		<!-- Darker body behind the selected tab's content. -->
		<Style Selector="TabControl.detector-tabs /template/ ContentPresenter#PART_SelectedContentHost">
			<Setter Property="Background" Value="#333333"/>
		</Style>
	</UserControl.Styles>
			<Border Background="#454545" BorderBrush="Black" BorderThickness="2" CornerRadius="5" BoxShadow="2 2 5 2 Black">
				<Expander IsExpanded="True" MinHeight="15" VerticalAlignment="Top" Background="#454545"  >
					<Expander.Resources>
						<LinearGradientBrush x:Key="ExpanderHeaderBackground" StartPoint="0%,0%" EndPoint="100%,0%">
								<GradientStop Color="#ba96e3" Offset="0.0"/>
								<GradientStop Color="#ad76ea" Offset="1.0"/>
						</LinearGradientBrush>

						<LinearGradientBrush x:Key="ExpanderHeaderBackgroundPointerOver" StartPoint="0%,0%" EndPoint="100%,0%">
							<GradientStop Color="#bd86fa" Offset="0.0"/>
							<GradientStop Color="#6173a5" Offset="1.0"/>
						</LinearGradientBrush>

						<LinearGradientBrush x:Key="ExpanderHeaderBackgroundPressed" StartPoint="0%,0%" EndPoint="100%,0%">
							<GradientStop Color="#8d56ca" Offset="0.0"/>
							<GradientStop Color="#415385" Offset="1.0"/>
						</LinearGradientBrush>

					</Expander.Resources>
					<Expander.Header>
						<Grid Margin="0">

							<TextBlock 	Margin="0 5 16 0" VerticalAlignment="Center" Height="25"  FontSize="17" Width="200" Background="Transparent">Acquisitions</TextBlock>
						</Grid>
					</Expander.Header>
					<StackPanel IsEnabled="{Binding IsEnableExperimentalPanel}"  Width="270" Background="#454545">


						<ListBox CornerRadius="5 5 5 5" 
									BorderBrush="Black" BorderThickness="1"
									Width="266"
									Background="Gray"
									HorizontalAlignment="Center"
									x:Name="AvailableAcquisitions"
									ItemsSource="{Binding SystemDefinedSettings.Acquisitions}"
									SelectedItem="{Binding SelectedAcquisition}"
									Margin="0 0 0 0"
									Height="100">
							<ListBox.ItemTemplate>
								<DataTemplate>
									<TextBox   HorizontalAlignment="Left" Margin="0 0 0 0"  Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
													Background="Transparent"
													VerticalContentAlignment="Center"
													BorderThickness="0"
													Height="22"
													Width="90"
													MinHeight="12"
													Padding="2"
													FontSize="12"
													CaretBrush="Black"
													Focusable="True"
													IsTabStop="True"/>

								</DataTemplate>
							</ListBox.ItemTemplate>
							<ListBox.Styles>
								<Style Selector="ListBoxItem">
									<Setter Property="Background" Value="Transparent"/>
									<Setter Property="Height" Value="25"/>
									<Setter Property="FontSize" Value="12"/>
									<Setter Property="Padding" Value="0"/>
									<Setter Property="Foreground" Value="White"/>
								</Style>
								<Style Selector="ListBoxItem:selected /template/ ContentPresenter">
									<Setter Property="Background">
										<Setter.Value>
											<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
												<GradientStop Color="#ba96e3" Offset="0.0"/>
												<GradientStop Color="#ad76ea" Offset="1.0"/>
											</LinearGradientBrush>
										</Setter.Value>
									</Setter>
									<Setter Property="Height" Value="25"/>
									<Setter Property="FontSize" Value="12"/>
									<Setter Property="Padding" Value="0"/>
									<Setter Property="CornerRadius" Value="5"/>
								</Style>
				
							</ListBox.Styles>
						</ListBox>

						<StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="146" Margin="2 0 0 0">
								<Button Height="25" Padding="0 3 0 3" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Width="60" BorderBrush="#2e2e2e" Command="{Binding	CopyAcquisition}">
									Copy
								</Button>	
								<Button Height="25" Padding="0 3 0 3" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Width="60" BorderBrush="#2e2e2e" Command="{Binding RemoveAcquisition}">
									Remove
								</Button>			
						</StackPanel>
						
						<!-- Sources -->
						<TextBlock Margin="5" FontSize="15">Available Sources</TextBlock>

						<!-- Channels -->
					<ItemsControl Margin="2 0 0 0" ItemsSource="{Binding SelectedAcquisition.Sources}">
						<ItemsControl.ItemTemplate>
							
						<DataTemplate x:DataType="vm:SourcesEquipmentViewModel">
							<ScrollViewer VerticalScrollBarVisibility="Auto">

								<Expander Width="265" IsExpanded="True" Padding="0" MinHeight="13" CornerRadius="5">
									<Expander.Resources>
										<SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Gray" ></SolidColorBrush>
										<x:Double  x:Key="ExpanderChevronButtonSize" >17</x:Double>

									</Expander.Resources>
									<Expander.Header>
										<Grid Margin="0">

											<TextBlock Text="{Binding DisplayedName}" 	Margin="0 0 16 0" VerticalAlignment="Center" Height="10"  FontSize="11" Width="200" Background="Transparent"></TextBlock>
										</Grid>
								</Expander.Header>



								<ItemsControl Margin="0 2 0 0" Background="Transparent"  ItemsSource="{Binding Channels}">
									<ItemsControl.ItemTemplate>
										<DataTemplate>

											<Grid Margin="2 2 0 2" ColumnDefinitions="100,0.5*,0.5*"  Height="20">
												<TextBlock Foreground="White" ToolTip.Tip="{Binding Name}" FontSize="12" Text="{Binding Name}" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
												<CheckBox BorderThickness="0.5"  Margin="0 0 10 0" Padding="0"  HorizontalAlignment="Right"  IsChecked="{Binding IsEnabled}" Grid.Row="0" Grid.Column="1"/>
												<NumericUpDown Classes="custom-numeric-style" HorizontalAlignment="Right" Value="{Binding PowerLevel}" Minimum="0" Maximum="100" Increment="1" Grid.Row="0" Grid.Column="2"/>



											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								</Expander>
							</ScrollViewer>
							</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>

						<!-- Filter settings -->
						<TextBlock Margin="4" FontSize="15">Movable components</TextBlock>



						<ItemsControl Margin="2 0 0 0" ItemsSource="{Binding SelectedAcquisition.FilterWheels}">
						<ItemsControl.ItemTemplate>
							
						<DataTemplate x:DataType="vm:MovableEquipmentViewModel">
							<ScrollViewer VerticalScrollBarVisibility="Auto">

								<Expander Width="265" IsExpanded="True" Padding="0" MinHeight="13" CornerRadius="5">
									<Expander.Resources>
										<SolidColorBrush x:Key="ExpanderHeaderBackground" Color="Gray" ></SolidColorBrush>
										<x:Double  x:Key="ExpanderChevronButtonSize" >17</x:Double>

									</Expander.Resources>
									<Expander.Header>
										<Grid Margin="0">

											<TextBlock Text="{Binding Name}" 	Margin="0 0 16 0" VerticalAlignment="Center" Height="10"  FontSize="11" Width="200" Background="Transparent"></TextBlock>
										</Grid>
								</Expander.Header>

								<ItemsControl Margin="0 2 0 0" Width="260"  ItemsSource="{Binding Properties}"></ItemsControl>

							</Expander>
							</ScrollViewer>
							</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>



	

						<!-- Detectors: one tab per detector so that additional cameras
						     do not consume vertical space in the pane. -->
						<TextBlock Margin="4" FontSize="15">Detector settings</TextBlock>
						<TabControl Classes="detector-tabs"
						            Margin="2 0 0 0"
						            Background="#333333"
						            BorderBrush="Black"
						            BorderThickness="1"
						            Padding="4"
						            ItemsSource="{Binding SelectedAcquisition.Detector}">
							<TabControl.ItemTemplate>
								<DataTemplate x:DataType="vm:DetectorEquipmentViewModel">
									<TextBlock Text="{Binding Name}"/>
								</DataTemplate>
							</TabControl.ItemTemplate>
							<TabControl.ContentTemplate>
								<DataTemplate x:DataType="vm:DetectorEquipmentViewModel">
									<StackPanel Background="Transparent">
									<ToggleSwitch Margin="2 4 0 2"
									              FontSize="12"
									              IsChecked="{Binding IsEnabled}"
									              OnContent="Use this detector"
									              OffContent="Use this detector"/>
										<ItemsControl Margin="0 2 0 0" Background="Transparent" ItemsSource="{Binding Properties}"/>
									</StackPanel>
								</DataTemplate>
							</TabControl.ContentTemplate>
					</TabControl>



	
						
					</StackPanel>
				</Expander>

			</Border >
</UserControl>
