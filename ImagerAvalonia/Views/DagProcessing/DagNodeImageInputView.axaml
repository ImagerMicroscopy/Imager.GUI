<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ImagerAvalonia.ViewModels"
			 xmlns:model="using:ImagerAvalonia.Services.MeasurementControl"
			 xmlns:dataTemplates="using:ImagerAvalonia.DataTemplates" 
             xmlns:views="clr-namespace:ImagerAvalonia.Views"
             mc:Ignorable="d"
             d:DesignWidth="120"
             d:DesignHeight="40"
			 ClipToBounds="False"
			 x:DataType="vm:DagNodeInputViewModel"
             x:Class="ImagerAvalonia.Views.DagNodeImageInputView">


	<StackPanel Orientation="Horizontal">
	    <Ellipse  x:Name="ConnectorPoint" PointerPressed="OnPointerPressed" StrokeThickness="2" Stroke="Black" Margin="-5 0 0 0" HorizontalAlignment="Left" Grid.Column="0" Fill="White" Width="10" Height="10"> </Ellipse>
	    <TextBlock Text="{Binding DisplayedType}" FontSize="10" Margin="4 0 0 0" Grid.Column="0" HorizontalAlignment="Left"/>
	</StackPanel>



</UserControl>