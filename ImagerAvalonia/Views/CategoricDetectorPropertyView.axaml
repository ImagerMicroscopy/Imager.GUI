<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ImagerAvalonia.ViewModels"
			 xmlns:model="using:ImagerAvalonia.Services.MeasurementControl"
			 xmlns:dataTemplates="using:ImagerAvalonia.DataTemplates" 
             xmlns:views="clr-namespace:ImagerAvalonia.Views"
             mc:Ignorable="d"
             d:DesignWidth="120"
             d:DesignHeight="40"
             x:Class="ImagerAvalonia.Views.CategoricDetectorPropertyView"
             x:DataType="vm:CategoricDetectorPropertyViewModel">

			<StackPanel Margin="-11 2 0 0" Width="240" Orientation="Horizontal">
				<TextBlock Foreground="White"  FontSize="12" HorizontalAlignment="Left" VerticalAlignment = "Center" Text="{Binding Label}" Width="110"/>
				<ComboBox BorderThickness="0.5" HorizontalAlignment="Center" FontSize="10" Padding="0" MinHeight="20" Height="20"  VerticalAlignment = "Center"  Margin="36 0 0 0" SelectedItem="{Binding SelectedChoice}" ItemsSource="{Binding Availableoptions}" Width="110">
					<ComboBox.Styles>
						<Style Selector="ComboBox ContentPresenter">
							<Setter Property="Margin" Value="5 0 0 0"/>
						</Style>
					</ComboBox.Styles>
				</ComboBox>
			</StackPanel>

</UserControl>