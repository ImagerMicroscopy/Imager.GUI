<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="200"
			 Width="286"
             xmlns:vm="clr-namespace:ImagerAvalonia.ViewModels"
             x:Class="ImagerAvalonia.Views.ImageRegionCollectionPropertiesView"
			 x:DataType="vm:ImageRegionDisplayViewModel">

	

	<StackPanel Spacing="4">
		<TextBlock FontSize="12" Foreground="White" Text="Region collections"/>
		<ListBox Background="#333333"
		         BorderBrush="#5f5f5f" BorderThickness="1" CornerRadius="4"
		         FontSize="12"
		         x:Name="RegionCollections"
		         ItemsSource="{Binding CollectionNames}"
		         SelectedItem="{Binding SelectedRegion}"
		         Height="100"/>
		<Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
			<Button Grid.Column="0" HorizontalAlignment="Stretch" FontSize="11" Command="{Binding SetPlotParams}">Plot</Button>
			<Button Grid.Column="1" HorizontalAlignment="Stretch" FontSize="11" Command="{Binding HideAllCollections}">Hide/Show all</Button>
			<Button Grid.Column="2" HorizontalAlignment="Stretch" FontSize="11" Command="{Binding DeleteCollection}">Delete</Button>
		</Grid>
	</StackPanel>
</UserControl>

