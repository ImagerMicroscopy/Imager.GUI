<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ImagerAvalonia.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:DataType="vm:SmartUpdateAcquisitionFunctionViewModel"
             x:Class="ImagerAvalonia.Views.SmartUpdateAcquisitionView">

	<UserControl.DataTemplates>
		<DataTemplate x:DataType="vm:UpdateAcquisitionFunctionParameterViewModel">
			<Grid ColumnDefinitions="80,90"  Margin="20 0 0 0" Width="170">
				<TextBlock Grid.Column="0" Text="{Binding ParameterName}"  Foreground="Black"  FontSize="8" HorizontalAlignment="Left" VerticalAlignment = "Center" Width="80"/>
				<ComboBox HorizontalAlignment="Right" Grid.Column="1" SelectedIndex="{Binding SelectedPathIndex}"  ItemsSource="{Binding EquipmentPaths}"   BorderThickness="0.5" FontSize="8" Padding="0" MinHeight="20" Height="20"  VerticalAlignment = "Center"  Margin="-10 0 0 0" SelectedItem="{Binding SelectedPath}" Width="90">
					<ComboBox.Styles>
						<Style Selector="ComboBox ContentPresenter">
							<Setter Property="Margin" Value="5 0 0 0"/>
						</Style>
					</ComboBox.Styles>
				</ComboBox>
			</Grid>
		</DataTemplate>
	</UserControl.DataTemplates>

<StackPanel Orientation="Vertical">

    <!-- EMPTY / DROP-ZONE STATE -->
    <Border IsVisible="{Binding !HasSelectedNode}"
            Background="#F5F6FA"
            BorderBrush="#9AA3B5"
            BorderThickness="1.5"
            CornerRadius="8"
            Height="60"
            Margin="0 0 0 12"
            DragDrop.AllowDrop="True"
            DragDrop.Drop="OnDrop"
            DragDrop.DragOver="OnDragOver">
        <Border.Styles>
            <Style Selector="Border:pointerover">
                <Setter Property="Background" Value="#EAF3FF"/>
                <Setter Property="BorderBrush" Value="#4C8DFF"/>
            </Style>
        </Border.Styles>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
            <TextBlock Text="Drop an update acquisition here"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#3A3F4B"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Drag from the experiment tree to bind it"
                       FontSize="10"
                       Foreground="#6B7280"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>

    <!-- FILLED STATE -->
    <Grid IsVisible="{Binding HasSelectedNode}"
          Margin="3 0 0 12"
          ColumnDefinitions="150,20,20">

        <TextBlock FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#1F2430"
                   Grid.Column="0"
                   Text="Selected Acquisition Update"/>

        <Rectangle Width="10" Height="10"
                   Fill="{Binding SmartProgramBinding.SmartProgramColor}"
                   Stroke="#9AA3B5"
                   StrokeThickness="1"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   IsHitTestVisible="True"/>

        <Button Click="OnClearSelectionClick"
                FontSize="14"
                Grid.Column="2"
                Margin="10 0 0 0"
                Width="20" Height="20"
                Padding="0"
                Background="Transparent"
                BorderThickness="0">
            <Button.Styles>
                <Style Selector="Button:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </Button.Styles>
            <TextBlock Text="✕"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="#E5484D"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Button>
    </Grid>

    <ItemsControl ItemsSource="{Binding AcquisitionUpdateParameters}"/>

</StackPanel>
</UserControl>
