<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ImagerAvalonia.ViewModels"
             xmlns:dataTemplates="using:ImagerAvalonia.DataTemplates"
             xmlns:views="clr-namespace:ImagerAvalonia.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             mc:Ignorable="d"
             d:DesignWidth="120"
             d:DesignHeight="40"
             x:Class="ImagerAvalonia.Views.InputFunctionView"
             x:DataType="vm:InputFunctionViewModel">

    <StackPanel Orientation="Vertical">

        <ItemsControl ItemsSource="{Binding MethodParams}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0 0 0 10">

                        <!-- EMPTY / DROP-ZONE STATE -->
                        <Border IsVisible="{Binding !HasSelectedDetection}"
                                Background="#F5F6FA"
                                BorderBrush="#9AA3B5"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Height="60"
                                Margin="0 0 0 12"
                                DragDrop.AllowDrop="True"
                                DragDrop.Drop="OnDrop"
                                DragDrop.DragOver="OnDragOver">
                            <Border.Styles>
                                <Style Selector="Border:pointerover">
                                    <Setter Property="Background" Value="#EAF3FF"/>
                                    <Setter Property="BorderBrush" Value="#4C8DFF"/>
                                </Style>
                            </Border.Styles>
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="4">
                                <TextBlock Text="Drop a detection here"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#3A3F4B"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Drag from the experiment tree to bind it"
                                           FontSize="10"
                                           Foreground="#6B7280"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- FILLED STATE -->
                        <StackPanel IsVisible="{Binding HasSelectedDetection}"
                                    Margin="0 0 0 12">

                            <Grid Margin="3 0 0 0" ColumnDefinitions="150,20,20">

                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2430"
                                           Grid.Column="0"
                                           Text="Selected Detection"/>

                                <Rectangle Width="8" Height="8" Fill="{Binding SmartProgramBinding.SmartProgramColor}"
                                           Grid.Column="1" IsHitTestVisible="True"/>

                                <Button Click="OnClearDropClick"
                                        FontSize="14"
                                        Grid.Column="2"
                                        Margin="10 0 0 0"
                                        Width="20" Height="20"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <Button.Styles>
                                        <Style Selector="Button:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                    </Button.Styles>
                                    <TextBlock Text="✕"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#E5484D"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="80,90" Margin="20 4 0 0" Width="170">
                                <TextBlock Grid.Column="0" Foreground="#1F2430" FontSize="10" FontWeight="Medium" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Acquisition" Width="80"/>
                                <ComboBox HorizontalAlignment="Right" Grid.Column="1" ItemsSource="{Binding FilteredAcquisitions}" DisplayMemberBinding="{Binding Name}" BorderThickness="0.5" FontSize="9" Padding="0" MinHeight="20" Height="20" VerticalAlignment="Center" Margin="-10 0 0 0" SelectedItem="{Binding AcquisitionInput}" Width="90">
                                    <ComboBox.Styles>
                                        <Style Selector="ComboBox ContentPresenter">
                                            <Setter Property="Margin" Value="5 0 0 0"/>
                                        </Style>
                                    </ComboBox.Styles>
                                </ComboBox>
                            </Grid>

                            <Grid ColumnDefinitions="80,90" Margin="20 4 0 0" Width="170">
                                <TextBlock Grid.Column="0" Foreground="#1F2430" FontSize="10" FontWeight="Medium" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Detector" Width="80"/>
                                <ComboBox HorizontalAlignment="Right" Grid.Column="1" ItemsSource="{Binding DefinedDetectors}" BorderThickness="0.5" FontSize="9" Padding="0" MinHeight="20" Height="20" VerticalAlignment="Center" Margin="-10 0 0 0" SelectedItem="{Binding DetectorInput}" Width="90">
                                    <ComboBox.Styles>
                                        <Style Selector="ComboBox ContentPresenter">
                                            <Setter Property="Margin" Value="5 0 0 0"/>
                                        </Style>
                                        <Style Selector="ComboBoxItem">
                                            <Setter Property="IsEnabled"
                                                    Value="{ReflectionBinding DataContext.IsEnabled, RelativeSource={RelativeSource Self}}" />
                                        </Style>
                                    </ComboBox.Styles>

                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                        </StackPanel>

                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>

</UserControl>