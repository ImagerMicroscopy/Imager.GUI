<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ImagerAvalonia.ViewModels"
			 xmlns:views="clr-namespace:ImagerAvalonia.Views"
			
             mc:Ignorable="d" d:DesignWidth="2200" d:DesignHeight="1850"
             x:Class="ImagerAvalonia.Views.SmartProgramView"
			 Background="#454545">





		<UserControl.Styles>
			<Style Selector="TabControl">
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate>
							<DockPanel>
								<!-- Tab headers on the left -->
								<StackPanel DockPanel.Dock="Left" Orientation="Vertical">
									<ItemsPresenter Name="PART_TabStripItemsHost" />
								</StackPanel>

								<!-- Selected tab content -->
								<ContentPresenter Name="PART_SelectedContentHost"
									Margin="{TemplateBinding Padding}"
									HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
									VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
									Content="{TemplateBinding SelectedContent}"
									ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
							</DockPanel>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>


			<Style Selector="TabItem">
				<Setter Property="Tag" Value="True"/>
				<Setter Property="Background" Value="#333"/>
				<Setter Property="Width" Value="25"/>
				<Setter Property="Height" Value="120"/>
				<Setter Property="HorizontalAlignment" Value="Left"/>
				<Setter Property="VerticalAlignment" Value="Top"/>
				<Style Selector="^:selected"> 
				   <Setter Property="Background" Value="Gray" /> 
				</Style> 
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate>
							<Border Background="{TemplateBinding Background}"
									BorderThickness="0"
									ClipToBounds="False">
								<StackPanel  VerticalAlignment="Bottom" Orientation="Horizontal" RenderTransformOrigin="0.5,0.5">
									
									<ContentPresenter
										ClipToBounds="False"
										Padding="0"
										HorizontalAlignment="Center"
										VerticalAlignment="Center"
										Content="{TemplateBinding Header}"
										ContentTemplate ="{TemplateBinding HeaderTemplate}">
										
									</ContentPresenter>

									<Button x:Name="CloseButton"
											Content="❌"
											Margin="0"
											Width="20"
											Height="20"
											Background="Transparent"
											BorderThickness="0"
											Padding="0"
											IsVisible="{TemplateBinding Tag}"
											IsEnabled="{TemplateBinding Tag}"
											Click="CloseButton_Click"/>

									<StackPanel.RenderTransform>
										<RotateTransform Angle="-90"/>
									</StackPanel.RenderTransform>
								</StackPanel>
							</Border>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>


			<Style Selector="ContentControl">
			<Setter Property="Margin" Value="0 -2 0 0"/>
		</Style>

	</UserControl.Styles>
	<Grid  RowDefinitions="*, 4,150">

	<TabControl Grid.Row="0" TabStripPlacement="Left"  DragDrop.AllowDrop="True"    BorderThickness="0" x:Name="SmartProgramTab" Padding="0" Margin="0" >

		<TabControl.Items>


			<TabItem    Height="40"  IsSelected="False"  Tag="False" >
				<TabItem.Header>
					<Button Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Click="TabProcessing_PointerPressed"  Padding="0" Width="35" Height="22"  Margin="-20 0 0 0">
						<Button.Styles>
							<Style Selector="Button">
								<Setter Property="Background" Value="LightGray"/>
								<Setter Property="Template">
									<Setter.Value>
										<ControlTemplate>
											<Border Background="{TemplateBinding Background}">
												<TextBlock Text="+" FontSize="24" Margin="12 -4 0 0">
	
												</TextBlock>
											</Border>
										</ControlTemplate>
									</Setter.Value>
								</Setter>
							</Style>
						</Button.Styles>
						
					</Button>
				</TabItem.Header>
				<TabItem.Styles>
					<Style Selector="TabItem:pointerover">
						<Setter Property="Background" Value="DarkGray"></Setter>
						<Setter Property="BorderBrush" Value="White"></Setter>
					</Style>
				</TabItem.Styles>
			</TabItem>

		</TabControl.Items>

		

	</TabControl>


	<GridSplitter Grid.Row="1" Background="Black" ResizeDirection="Rows"/>
	<ContentControl Grid.Row="2">
		<views:SmartServerOutputView></views:SmartServerOutputView>
	</ContentControl>
	</Grid>

	

</UserControl>
